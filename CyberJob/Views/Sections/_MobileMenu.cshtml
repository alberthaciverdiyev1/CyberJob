@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}

<div id="mobile-bottom-nav"
     class="fixed bottom-0 left-0 right-0 lg:hidden z-50 transition-all duration-500 ease-in-out"
     style="transform: translateY(0); opacity: 1;">
    <div class="px-4 pb-4 sm:pb-5">
        <div class="relative bg-[#0B2036]/90 dark:bg-black/90 backdrop-blur-xl rounded-2xl border border-white/10 shadow-[0_-4px_30px_rgba(0,0,0,0.4)]">
            <div class="flex items-center justify-around px-2 py-1">

                @* 1. Home *@
                <a asp-controller="Home" asp-action="Index"
                   class="relative flex flex-col items-center justify-center gap-0 py-2 w-[60px] transition-all duration-200
                          @((controller == "" || controller == "Home") ? "text-cyberGreen" : "text-gray-400 hover:text-cyberGreen")">
                    <iconify-icon icon="ph:house-simple" class="text-[22px]"></iconify-icon>
                    <span class="text-[10px] font-medium leading-none mt-[3px]">@Localizer["mobile.home"]</span>
                </a>

                @* 2. Search *@
                <a href="/vacancies"
                   class="relative flex flex-col items-center justify-center gap-0 py-2 w-[60px] transition-all duration-200
                          @(controller == "Vacancy" ? "text-cyberGreen" : "text-gray-400 hover:text-cyberGreen")">
                    <iconify-icon icon="ph:magnifying-glass" class="text-[22px]"></iconify-icon>
                    <span class="text-[10px] font-medium leading-none mt-[3px]">@Localizer["mobile.search"]</span>
                </a>

                @* 3. Center: iş çantası *@
                <div class="relative -mt-5 flex-shrink-0">
                    <a asp-controller="Vacancy" asp-action="Index"
                       class="flex items-center justify-center w-[52px] h-[52px] rounded-full bg-gradient-to-br from-cyberGreen to-[#00b8a8] text-white shadow-lg shadow-cyberGreen/30 hover:shadow-cyberGreen/40 hover:scale-110 active:scale-90 transition-all duration-200"
                       aria-label="Post vacancy">
                        <iconify-icon icon="ph:suitcase" class="text-[26px]"></iconify-icon>
                    </a>
                </div>

                @* 4. Leaderboard *@
                <a asp-controller="Rank" asp-action="Index"
                   class="relative flex flex-col items-center justify-center gap-0 py-2 w-[60px] transition-all duration-200
                          @(controller == "Rank" ? "text-cyberGreen" : "text-gray-400 hover:text-cyberGreen")">
                    <iconify-icon icon="ph:trophy" class="text-[22px]"></iconify-icon>
                    <span class="text-[10px] font-medium leading-none mt-[3px]">@Localizer["mobile.leaderboard"]</span>
                </a>

                @* 5. Prices *@
                <a asp-controller="StaticPage" asp-action="Services"
                   class="relative flex flex-col items-center justify-center gap-0 py-2 w-[60px] transition-all duration-200
                          @(controller == "StaticPage" && action == "Services" ? "text-cyberGreen" : "text-gray-400 hover:text-cyberGreen")">
                    <iconify-icon icon="ph:currency-dollar" class="text-[22px]"></iconify-icon>
                    <span class="text-[10px] font-medium leading-none mt-[3px]">@Localizer["nav.services"]</span>
                </a>

            </div>
        </div>
    </div>
</div>

<script>
(function () {
    var nav = document.getElementById('mobile-bottom-nav');
    if (!nav) return;

    var lastScrollY = window.scrollY;
    var ticking = false;
    var threshold = 80;
    var accumulatedDown = 0;

    window.addEventListener('scroll', function () {
        if (!ticking) {
            window.requestAnimationFrame(function () {
                var currentScrollY = window.scrollY;

                if (currentScrollY > threshold) {
                    if (currentScrollY > lastScrollY) {
                        accumulatedDown += currentScrollY - lastScrollY;
                        if (accumulatedDown > 20) {
                            nav.style.transform = 'translateY(100%)';
                            nav.style.opacity = '0';
                            nav.style.pointerEvents = 'none';
                        }
                    } else if (currentScrollY < lastScrollY) {
                        accumulatedDown = 0;
                        nav.style.transform = 'translateY(0)';
                        nav.style.opacity = '1';
                        nav.style.pointerEvents = 'auto';
                    }
                } else {
                    accumulatedDown = 0;
                    nav.style.transform = 'translateY(0)';
                    nav.style.opacity = '1';
                    nav.style.pointerEvents = 'auto';
                }

                lastScrollY = currentScrollY;
                ticking = false;
            });
            ticking = true;
        }
    }, { passive: true });
})();
</script>
