@using CyberJob.DTOs
@using CyberJob.Helpers
@using static CyberJob.Helpers.HtmlSanitizerHelper


@section Styles {
    <link rel="stylesheet" href="~/css/vacancy-details.css"/>
}

<main class="max-w-[1440px] mx-auto px-4 sm:px-10 lg:px-[100px] py-6 sm:py-10">
    @{
        bool hasBanner = (Model.Vacancy.BannerImage ?? Model.Vacancy.Company?.BannerImage) != null;
    }
    <div class="flex flex-col lg:flex-row @(hasBanner ? "items-stretch" : "items-start lg:items-center") gap-4 mb-8 sm:mb-12">
        <div
            class="w-full @(hasBanner ? "sm:max-w-[490px] h-[120px] sm:h-[170px]" : "sm:max-w-full") bg-white dark:bg-cyberGray rounded-[15px] p-5 sm:p-6 flex items-center gap-4 shadow-[0_4px_20px_rgba(0,0,0,0.03)]">
            <div class="w-16 h-16 sm:w-20 sm:h-20 shrink-0">
                <img src="@Model.Vacancy.Company.Logo" alt="Logo" class="w-full h-full object-contain">
            </div>
            <div class="min-w-0">
                <h1 class="text-lg sm:text-xl lg:text-2xl font-bold dark:text-white truncate">@Model.Vacancy.Name</h1>
                <p class="text-[#95A1B0] dark:text-gray-400 font-bold text-sm sm:text-lg flex items-center gap-2">
                    @Model.Vacancy.Company.Name
                    <iconify-icon icon="material-symbols:verified" class="text-[#2D9CDB] shrink-0"></iconify-icon>
                </p>
                <div class="flex items-center gap-3 sm:gap-4 mt-2 sm:mt-3 flex-wrap">
                    <span
                        class="text-orange-400 px-2 sm:px-3 py-1 rounded-md text-[10px] sm:text-xs font-bold border border-[#FFB800]/20">@Localizer.Get("vacancy.detail.last_date", Model.Vacancy.ExpireDate?.ToString("dd.MM.yyyy"))  </span>
                    <span class="text-[#95A1B0] text-[10px] sm:text-xs flex items-center gap-1">
                        <iconify-icon
                            icon="ph:eye-bold"></iconify-icon> @Localizer.Get("vacancy.detail.views", Model.Vacancy.ViewCount)
                    </span>
                </div>
            </div>
        </div>

        @if (hasBanner)
        {
            <div
                class="w-full max-w-[730px] lg:w-[730px] h-[120px] sm:h-[170px] rounded-[15px] overflow-hidden shadow-[0_4px_20px_rgba(0,0,0,0.05)]">
                <img src="@(Model.Vacancy.BannerImage ?? Model.Vacancy.Company?.BannerImage ?? "")"
                     alt="Reklam"
                     class="w-full h-full object-fit">
            </div>
        }
    </div>

    <div class="flex flex-col lg:flex-row gap-6 sm:gap-10">
        <div class="@(hasBanner ? "flex-1" : "w-full") bg-white dark:bg-black p-6 sm:p-10 rounded-[15px] shadow-sm">
            <h3 class="text-[18px] sm:text-[20px] font-black text-[#0B2036] dark:text-white mb-4 sm:mb-6">@Localizer["vacancy.detail.description"]</h3>
            <div class="text-[#4F5B67] dark:text-gray-300 leading-relaxed space-y-4 text-[14px] sm:text-[15px]">
                @Html.Raw(SanitizeWithLineBreaks(Model.Vacancy.Description))
            </div>

            <h3 class="text-[18px] sm:text-[20px] font-black text-[#0B2036] dark:text-white mt-8 sm:mt-10 mb-4 sm:mb-6">@Localizer["vacancy.detail.requirements"]</h3>
            <div class="text-[#4F5B67] dark:text-gray-300 leading-relaxed space-y-4 text-[14px] sm:text-[15px]">
                @Html.Raw(SanitizeWithLineBreaks(Model.Vacancy.Requirements))
            </div>

            <div
                class="mt-8 sm:mt-10 pt-6 border-t dark:border-gray-700 flex gap-4 sm:gap-6 text-[#95A1B0] font-bold text-xs sm:text-sm">
                <button class="flex items-center gap-2 hover:text-[#009689] transition-colors">
                    <iconify-icon icon="ph:share-network-bold"></iconify-icon>
                    @Localizer["vacancy.detail.share"]
                </button>
                <button onclick="openModal()" class="flex items-center gap-2 hover:text-red-500 transition-colors">
                    <iconify-icon icon="ph:warning-circle-bold"></iconify-icon>
                    @Localizer["vacancy.detail.report"]
                </button>
            </div>
        </div>

        @if (hasBanner)
        {
        <aside class="w-full lg:w-[400px] shrink-0">
            <div class="max-w-[400px] w-full bg-white dark:bg-[#0a0a0a] border border-gray-200 dark:border-gray-700 rounded-2xl shadow-sm overflow-hidden">
                <!-- Header -->
                <div class="bg-[#0B1E33] text-white flex items-center justify-center gap-2 py-4 px-6">
                    <svg class="w-5 h-5 stroke-current fill-none" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="16" x2="12" y2="12"></line>
                        <line x1="12" y1="8" x2="12.01" y2="8"></line>
                    </svg>
                    <span class="font-semibold text-base">@Localizer["vacancy.detail.quick_info"]</span>
                </div>

                <!-- Body -->
                <div class="p-6 space-y-4 dark:bg-[#0a0a0a]">
                    <!-- City -->
                    <div class="border-b border-gray-100 dark:border-gray-800 pb-4">
                        <span class="block text-sm font-bold dark:text-white mb-2">@Localizer["vacancy.detail.city"]</span>
                        <div class="flex items-center gap-2 text-gray-400 text-sm font-medium">
                            <svg class="w-5 h-5 stroke-current fill-none text-teal-600 shrink-0" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                <circle cx="12" cy="10" r="3"></circle>
                            </svg>
                            <span>@Model.Vacancy.City</span>
                        </div>
                    </div>

                    <!-- Dynamic Filters -->
                    @foreach (FilterDetailDto v in Model.Vacancy.Filters)
                    {
                        <div class="border-b border-gray-100 dark:border-gray-800 pb-4">
                            <span class="block text-sm font-bold dark:text-white mb-2">@v.ParentName</span>
                            <div class="flex items-center gap-2 text-gray-400 text-sm font-medium">
                                <svg class="w-5 h-5 stroke-current fill-none text-teal-600 shrink-0" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                                    <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                                </svg>
                                <span>@v.Name</span>
                            </div>
                        </div>
                    }

                    <!-- Salary -->
                    <div class="border-b border-gray-100 dark:border-gray-800 pb-4">
                        <span class="block text-sm font-bold dark:text-white mb-2">@Localizer["vacancy.detail.salary"]</span>
                        <div class="flex items-center gap-2 text-gray-400 text-sm font-medium">
                            <svg class="w-5 h-5 stroke-current fill-none text-teal-600 shrink-0" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="2" y="4" width="20" height="16" rx="2" ry="2"></rect>
                                <line x1="2" y1="10" x2="22" y2="10"></line>
                            </svg>
                            <span>@Model.Vacancy.Salary</span>
                        </div>
                    </div>

                    <!-- Last Date -->
                    <div class="border-b border-gray-100 dark:border-gray-800 pb-4">
                        <span class="block text-sm font-bold dark:text-white mb-2">@Localizer["vacancy.detail.last_date"]</span>
                        <div class="flex items-center gap-2 text-gray-400 text-sm font-medium">
                            <svg class="w-5 h-5 stroke-current fill-none text-teal-600 shrink-0" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"></circle>
                                <polyline points="12 6 12 12 16 14"></polyline>
                            </svg>
                            <span>@Model.Vacancy.ExpireDate?.ToString("dd.MM.yyyy")</span>
                        </div>
                    </div>

                    <!-- Apply Button / Email -->
                    @if (!string.IsNullOrEmpty(Model.Vacancy.ApplicationUrl))
                    {
                        <div class="pt-2">
                            <a href="@Model.Vacancy.ApplicationUrl" target="_blank" rel="noopener noreferrer"
                               class="inline-flex items-center gap-3 bg-[#149C8A] hover:bg-[#0f8575] text-white px-5 py-3 rounded-xl text-sm font-medium shadow-sm transition-all w-full justify-center">
                                <svg class="w-4 h-4 stroke-current fill-none shrink-0" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                                    <polyline points="22,6 12,13 2,6"></polyline>
                                </svg>
                                @Localizer["vacancy.detail.apply"]
                            </a>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(Model.Vacancy.Email ?? Model.Vacancy.Company.Email))
                    {
                        var contactEmail = Model.Vacancy.Email ?? Model.Vacancy.Company.Email;
                        <div class="pt-2">
                            <a href="mailto:@contactEmail"
                               class="inline-flex items-center gap-3 bg-[#149C8A] hover:bg-[#0f8575] text-white px-5 py-3 rounded-xl text-sm font-medium shadow-sm transition-all w-full justify-center">
                                <svg class="w-4 h-4 stroke-current fill-none shrink-0" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                                    <polyline points="22,6 12,13 2,6"></polyline>
                                </svg>
                                @contactEmail
                            </a>
                        </div>
                    }
                </div>
            </div>
        </aside>
        }
    </div>

    <div class="social-cta-wrapper flex justify-center w-full mb-8 sm:mb-12">
        <div
            class="w-full max-w-[1239px] bg-white dark:bg-darkGreen rounded-2xl border border-b-cyberGreen dark:border-gray-700 flex items-center justify-between px-5 my-8 sm:my-10 min-h-[70px] flex-col sm:flex-row gap-4 py-4 sm:py-0">
            <div class="flex items-center gap-3 sm:gap-4">
                <div class="flex-shrink-0 flex items-center justify-center w-[40px] sm:w-[53px] h-[50px] sm:h-[74px]">
                    <img src="~/images/robotelan.png" alt="robot" class="w-full h-full object-contain">
                </div>
                <span
                    class="text-xl sm:text-base font-semibold text-black dark:text-white">@Localizer["vacancy.detail.social_title"]</span>
            </div>
            <div class="flex items-center gap-2 sm:gap-3">
                <a href="@(await SettingHelper.Get("instagram_url"))" class="social-icon" target="_blank"
                   rel="noopener noreferrer" aria-label="Instagram">
                    <img src="~/images/insta.png" alt="Instagram" width="24" height="24" loading="lazy">
                </a>

                <a href="@(await SettingHelper.GetSocialUrl("telegram_number"))" class="social-icon" target="_blank"
                   rel="noopener noreferrer" aria-label="Telegram">
                    <img src="~/images/tg.png" alt="Telegram" width="24" height="24" loading="lazy">
                </a>

                <a href="@(await SettingHelper.GetSocialUrl("whatsapp_number"))" class="social-icon" target="_blank"
                   rel="noopener noreferrer" aria-label="WhatsApp">
                    <img src="~/images/vp.png" alt="WhatsApp" width="24" height="24" loading="lazy">
                </a>

                <a href="@(await SettingHelper.Get("linkedin_url"))" class="social-icon" target="_blank"
                   rel="noopener noreferrer" aria-label="LinkedIn">
                    <img src="~/images/linkedin.png" alt="LinkedIn" width="24" height="24" loading="lazy">
                </a>

                <a href="@(await SettingHelper.Get("facebook_url"))" class="social-icon" target="_blank"
                   rel="noopener noreferrer" aria-label="Facebook">
                    <img src="~/images/fbicon.png" alt="Facebook" width="24" height="24" loading="lazy">
                </a>

                <a href="@(await SettingHelper.Get("tiktok_url"))" class="social-icon" target="_blank"
                   rel="noopener noreferrer" aria-label="TikTok">
                    <iconify-icon icon="ph:tiktok-logo-fill" class="text-black text-xl"></iconify-icon>
                </a>

                <a href="@(await SettingHelper.Get("youtube_url"))" class="social-icon" target="_blank"
                   rel="noopener noreferrer" aria-label="YouTube">
                    <iconify-icon icon="ph:youtube-logo-fill" class="text-black text-xl"></iconify-icon>
                </a>

                <a href="@(await SettingHelper.Get("twitter_url"))" class="social-icon" target="_blank"
                   rel="noopener noreferrer" aria-label="Twitter / X">
                    <iconify-icon icon="ph:x-logo-fill" class="text-black text-xl"></iconify-icon>
                </a>
            </div>
        </div>
    </div>

    <section>
        <div class="flex justify-between items-center mb-6 sm:mb-8">
            <h2 class="text-xl sm:text-3xl font-black text-black dark:text-white">@Localizer["vacancy.detail.more_ads"]</h2>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4">
            @foreach (VacancyListDto v in Model.SimilarVacancies)
            {
                <a href="/vacancies/@v.Id"
                   class="border border-gray-300 dark:border-gray-700 dark:bg-[#0a0a0a] flex flex-col relative p-3 sm:p-4 transition-all hover:-translate-y-1 shadow-sm rounded-2xl">
                    <div class="flex items-start gap-2.5 mb-2 overflow-hidden">
                        <div class="size-12 sm:size-14 rounded-full overflow-hidden shrink-0">
                            <img src="@v.Company.Logo" alt="@v.Company.Name" class="w-full h-full object-cover"/>
                        </div>
                        <div class="min-w-0 flex-1">
                            <h3 class="text-sm font-bold text-black dark:text-white leading-tight truncate">@v.Name</h3>
                            <div class="mt-1.5 flex items-center w-full">
                                <span class="text-xs text-gray-400 font-semibold truncate flex items-center gap-1">
                                    @v.Company.Name
                                    @if (v.Company.IsVerified)
                                    {
                                        <iconify-icon icon="material-symbols:verified" class="text-[#2D9CDB] shrink-0"></iconify-icon>
                                    }
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="mt-auto">
                        <div class="w-full h-[0.5px] bg-gray-400/20 dark:bg-gray-800/40 mb-2"></div>
                        <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-gray-400 text-xs">
                            <span class="flex items-center gap-1"><iconify-icon icon="ph:clock-bold"></iconify-icon> @v.CreatedAt?.ToString("dd.MM.yyyy")</span>
                            <span class="flex items-center gap-1"><iconify-icon icon="ph:eye-bold"></iconify-icon> @v.ViewCount</span>
                            <span class="text-darkGreen font-bold ml-auto">@v.Salary</span>
                        </div>
                    </div>
                </a>
            }

            <a asp-controller="Vacancy" asp-action="Index"
               class="sm:hidden mt-4 text-center text-white bg-cyberGreen rounded-xl py-2 hover: cursor-pointer block">@Localizer["vacancy.detail.more"]</a>
        </div>
    </section>
</main>

<div id="reportModal" class="modal-overlay" onclick="closeModal()">
    <div
        class="w-full max-w-[720px] bg-white dark:bg-[#1a1a1a] rounded-3xl p-8 sm:p-6 relative max-h-[90vh] overflow-y-auto"
        onclick="event.stopPropagation()">
        <div class="flex justify-between items-center mb-8">
            <h2 class="text-2xl font-extrabold text-[#0B2036] dark:text-white">@Localizer["vacancy.detail.report_title"]</h2>
            <span class="cursor-pointer text-2xl sm:text-[28px] text-[#95A1B0]" onclick="closeModal()">
                <iconify-icon icon="material-symbols:close-rounded"></iconify-icon>
            </span>
        </div>

        <form id="reportForm">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-5 mb-8">
                <label
                    class="flex items-center gap-3 cursor-pointer font-semibold text-base text-[#0B2036] dark:text-gray-200">
                    <input type="checkbox" class="w-[22px] h-[22px] accent-[#52A38F] cursor-pointer" name="reason"
                           value="1">
                    @Localizer["vacancy.detail.report.reason1"]
                </label>
                <label
                    class="flex items-center gap-3 cursor-pointer font-semibold text-base text-[#0B2036] dark:text-gray-200">
                    <input type="checkbox" class="w-[22px] h-[22px] accent-[#52A38F] cursor-pointer" name="reason"
                           value="2" checked>
                    @Localizer["vacancy.detail.report.reason2"]
                </label>
                <label
                    class="flex items-center gap-3 cursor-pointer font-semibold text-base text-[#0B2036] dark:text-gray-200">
                    <input type="checkbox" class="w-[22px] h-[22px] accent-[#52A38F] cursor-pointer" name="reason"
                           value="3">
                    @Localizer["vacancy.detail.report.reason3"]
                </label>
                <label
                    class="flex items-center gap-3 cursor-pointer font-semibold text-base text-[#0B2036] dark:text-gray-200">
                    <input type="checkbox" class="w-[22px] h-[22px] accent-[#52A38F] cursor-pointer" name="reason"
                           value="4">
                    @Localizer["vacancy.detail.report.reason4"]
                </label>
                <label
                    class="flex items-center gap-3 cursor-pointer font-semibold text-base text-[#0B2036] dark:text-gray-200">
                    <input type="checkbox" class="w-[22px] h-[22px] accent-[#52A38F] cursor-pointer" name="reason"
                           value="5">
                    @Localizer["vacancy.detail.report.reason5"]
                </label>
                <label
                    class="flex items-center gap-3 cursor-pointer font-semibold text-base text-[#0B2036] dark:text-gray-200">
                    <input type="checkbox" class="w-[22px] h-[22px] accent-[#52A38F] cursor-pointer" name="reason"
                           value="6">
                    @Localizer["vacancy.detail.report.reason6"]
                </label>
                <label
                    class="flex items-center gap-3 cursor-pointer font-semibold text-base text-[#0B2036] dark:text-gray-200">
                    <input type="checkbox" class="w-[22px] h-[22px] accent-[#52A38F] cursor-pointer" name="reason"
                           value="7">
                    @Localizer["vacancy.detail.report.reason7"]
                </label>
            </div>

            <button type="submit"
                    class="w-full max-w-[320px] bg-[#52A38F] hover:bg-[#438a78] text-white font-bold py-4 rounded-xl mx-auto mt-5 block text-lg transition-colors">@Localizer["vacancy.detail.report.send"]</button>
        </form>
    </div>
</div>

<script>
    function openModal() {
        document.getElementById('reportModal').style.display = 'flex';
        document.body.style.overflow = 'hidden';
    }

    function closeModal() {
        document.getElementById('reportModal').style.display = 'none';
        document.body.style.overflow = 'auto';
    }
</script>
