@using CyberJob.DTOs
@model IEnumerable<VacancyListDto>
@{
    int i = 0;
}

@foreach (VacancyListDto vacancy in Model)
{
    <a href="/vacancies/@vacancy.Id" 
       class="relative bg-white dark:bg-zinc-900 shadow-sm
                border border-gray-50 dark:border-zinc-800 
                flex items-center justify-between px-6 transition-all
                hover:border-extraLightGreen hover:shadow-md cursor-pointer
                 w-full block no-underline min-h-28 rounded-3xl mb-4
                     @(vacancy.IsPremium ? "!border-gold border-4" : "bg-white dark:bg-zinc-900")                
                ">
        
        <div class="flex items-center gap-6">
            <div class="flex items-center justify-center overflow-hidden shrink-0 border border-gray-100 w-20 h-20 rounded-lg">
                <img src="@vacancy.Company.Logo" class="w-full h-full object-fit" alt="@vacancy.Company.Name">
            </div>

            <div class="flex flex-col justify-center">
                <h3 class="font-bold text-xl dark:text-white leading-tight mb-1">@vacancy.Name</h3>
                <p class="text-gray-400 font-semibold text-lg flex items-center gap-2">
                    @vacancy.Company.Name
                    @if (vacancy.Company.IsVerified)
                    {
                        <iconify-icon icon="material-symbols:verified" class="text-[#2D9CDB]"></iconify-icon>
                    }
                    <span >@vacancy.CityName</span>
                </p>
                <div class="flex items-center gap-5 text-sm text-gray-400 mt-1 font-semibold ">
                    <span class="flex items-center gap-1.5">
                        <iconify-icon icon="ph:clock-light" class="text-xl"></iconify-icon>
                        @vacancy.CreatedAt?.ToString("dd.MM.yyyy")
                        </span>
                    <span class="flex items-center gap-1.5">
                        <iconify-icon icon="ph:eye-light" class="text-xl"></iconify-icon>
                        @vacancy.ViewCount baxış
                    </span>
                </div>
            </div>
        </div>

        <div class="absolute bottom-3 right-6 text-right shrink-0">
            <p class="text-darkGreen font-bold text-md">@vacancy.Salary</p>
        </div>
    </a>

    if (i == 4 || i == 14 || i == 29 || i == 44 || i == 59)
    {
        <div class="my-6 overflow-hidden w-full h-44 rounded-3xl">
            <img src="~/images/banner.jpg" alt="Reklam" class="w-full h-full object-cover">
        </div>
    }

    i++;
}