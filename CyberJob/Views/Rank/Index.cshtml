@using CyberJob.DTOs
<style>


    /* Podium Gradientləri */
    .podium-gradient-gold {
        background: linear-gradient(180deg, #FBD38D 0%, #ECC94B 50%, #B7791F 100%);
    }

    .podium-gradient-silver {
        background: linear-gradient(180deg, #E2E8F0 0%, #A0AEC0 50%, #4A5568 100%);
    }

    .podium-gradient-bronze {
        background: linear-gradient(180deg, #ED8936 0%, #C05621 50%, #7B341E 100%);
    }


    /* FAQ Animasiyası */
    .faq-answer {
        max-height: 0;
        overflow: hidden;
        transition: all 0.3s ease-out;
    }

    .faq-item.active .faq-answer {
        max-height: 300px;
        padding-bottom: 24px;
    }

    .faq-item.active iconify-icon {
        transform: rotate(180deg);
    }

    .podium-top {
        clip-path: polygon(15% 0%, 85% 0%, 100% 100%, 0% 100%);
    }
</style>
@{
    Layout = Context.Request.Headers.ContainsKey("HX-Request") ? null : "_Layout";
}

<div class="w-full mx-auto pt-16 bg-[#0B2036]">

    @if (Layout != null)
    {
        <h1 class="text-5xl flex flex-1 justify-center text-white font-semibold mb-16 tracking-tight">Şirkət siyahısının
            üstünlükləri!</h1>

        <div class="grid grid-cols-1 md:grid-cols-3 mb-20">
            <div class="flex flex-col items-center relative group">

                <div
                    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-48 h-48 bg-[#14516D]/60 rounded-full blur-[50px] opacity-80 group-hover:opacity-100 transition-opacity"></div>

                <img src="~/images/winner.png" class="relative z-10 h-72 mb-6 drop-shadow-2xl" alt="Winner">

                <p class="relative z-10 text-md text-white leading-relaxed max-w-[260px]">
                    Ayın lideri ol, <span class="font-bold">1 aylıq "Blue Tick"</span> nişanını ödənişsiz
                    əldə et.
                </p>
            </div>
            <div class="flex flex-col items-center relative group">

                <div
                    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-48 h-48 bg-[#14516D]/60 rounded-full blur-[50px] opacity-80 group-hover:opacity-100 transition-opacity"></div>

                <img src="~/images/fly.png" class="relative z-10 h-72 mb-6 drop-shadow-2xl" alt="Fly">

                <p class="relative z-10 text-md text-white leading-relaxed max-w-[260px]">
                    Nə qədər aktivsənsə, sıralamada bir o qədər öndəsən.
                </p>
            </div>
            <div class="flex flex-col items-center relative group">

                <div
                    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-48 h-48 bg-[#14516D]/60 rounded-full blur-[50px] opacity-80 group-hover:opacity-100 transition-opacity"></div>

                <img src="~/images/strong.png" class="relative z-10 h-72 mb-6 drop-shadow-2xl" alt="Strong">

                <p class="relative z-10 text-md text-white leading-relaxed max-w-[260px]">
                    Rəqabətə qoşul və şirkətinin nüfuzunu artır!
                </p>
            </div>
        </div>

        <div class="relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] w-screen leading-[0] -mt-48">
            <svg viewBox="0 0 1440 200" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto">
                <defs>
                    <filter id="colorGlow" x="-20%" y="-20%" width="140%" height="300%">
                        <feDropShadow dx="0" dy="8" stdDeviation="6" flood-color="#14516D" flood-opacity="0.7"/>
                    </filter>
                </defs>

                <path d="M0 20C360 200 1080 200 1440 20"
                      stroke="#14516D"
                      stroke-width="4"
                      stroke-linecap="round"
                      fill="none"
                      filter="url(#colorGlow)"/>
            </svg>
        </div>

        string currentDate = Context.Request.Query["date"].ToString();
        if (string.IsNullOrEmpty(currentDate)) currentDate = "this_month";

        string activeClass = "bg-zinc-800 text-white font-semibold";
        string inactiveClass = "opacity-60 font-medium hover:opacity-100 transition";

        <div class="w-full flex justify-center -mt-24">
            <div
                class="inline-flex bg-black/40 backdrop-blur-md p-1 rounded-2xl mb-28 shadow-2xl border border-white/10">
                <button hx-get="/rank?date=this_month" hx-target="#company-list-container" hx-push-url="true"
                        hx-on:click="updateTabClasses(this)"
                        class="filter-btn px-16 py-2.5 rounded-xl text-sm text-white @(currentDate == "this_month" ? activeClass : inactiveClass)">
                    Aylıq
                </button>

                <button hx-get="/rank?date=last_month" hx-target="#company-list-container" hx-push-url="true"
                        hx-on:click="updateTabClasses(this)"
                        class="filter-btn px-16 py-2.5 rounded-xl text-sm text-white  @(currentDate == "last_month" ? activeClass : inactiveClass)">
                    Ötən ay
                </button>

                <button hx-get="/rank?date=all_time" hx-target="#company-list-container" hx-push-url="true"
                        hx-on:click="updateTabClasses(this)"
                        class="filter-btn px-16 py-2.5 rounded-xl text-sm text-white @(currentDate == "all_time" ? activeClass : inactiveClass)">
                    Bütün vaxtlar
                </button>
            </div>
        </div>
    }


    <div id="company-list-container"    >
        @if (Model.Companies != null && Model.Companies.Count >= 3)
        {
            <div
                class="flex flex-col md:flex-row items-end justify-center gap-6 md:gap-12 px-4 md:px-12 lg:px-24 mx-auto mb-32">

                <div class="w-full md:w-[28%] flex flex-col items-center relative">
                    <div
                        class="w-48 h-48 rounded-full bg-white p-1 border-[8px] border-slate-400 mb-4 overflow-hidden shadow-lg">
                        <img src="@Model.Companies[1].Logo" class="w-full h-full object-cover" alt="Rank 2">
                    </div>
                    <h3 class="font-bold mb-2 text-2xl text-white">@Model.Companies[1].Name</h3>

                    <div class="relative w-full flex flex-col items-center">
                        <div
                            class="absolute top-5 z-30 podium-gradient-silver p-3 rounded-xl shadow-lg border border-white/20">
                            <iconify-icon icon="ph:trophy-fill" class="text-white text-3xl block"></iconify-icon>
                        </div>

                        <div class="podium-gradient-silver h-14 w-full podium-top"></div>
                        <div
                            class="podium-gradient-silver w-full pt-10 pb-12 h-96 flex flex-col items-center justify-between text-white shadow-xl relative">
                            <span class="font-bold opacity-90">@Model.Companies[1].VacancyCount Elan</span>
                            <span class="text-8xl font-bold mb-20">2</span>
                        </div>
                    </div>
                </div>

                <div class="w-full md:w-[28%] flex flex-col items-center z-20 scale-100 md:scale-105 mb-36 relative">
                    <div
                        class="w-48 h-48 rounded-full bg-white p-1 border-[8px] border-yellow-500 mb-4 overflow-hidden shadow-[0_0_30px_rgba(234,179,8,0.4)]">
                        <img src="@Model.Companies[0].Logo" class="w-full h-full object-contain" alt="Rank 1">
                    </div>
                    <h3 class="font-bold mb-4 text-2xl text-white">@Model.Companies[0].Name</h3>

                    <div class="relative w-full flex flex-col items-center">
                        <div
                            class="absolute top-5 z-30 podium-gradient-gold p-4 rounded-xl shadow-[0_0_20px_rgba(234,179,8,0.5)] border border-yellow-200/50">
                            <iconify-icon icon="ph:trophy-fill" class="text-white text-4xl block"></iconify-icon>
                        </div>

                        <div class="podium-gradient-gold h-14 w-full podium-top"></div>
                        <div
                            class="podium-gradient-gold w-full pt-12 pb-14 h-96 flex flex-col items-center justify-between text-white shadow-2xl relative">
                            <span class="font-bold text-lg">@Model.Companies[0].VacancyCount Elan</span>
                            <span class="text-9xl font-bold mb-20">1</span>
                        </div>
                    </div>
                </div>

                <div class="w-full md:w-[28%] flex flex-col items-center relative">
                    <div
                        class="w-48 h-48 rounded-full bg-white p-1 border-[8px] border-orange-700 mb-4 overflow-hidden shadow-lg">
                        <img src="@Model.Companies[2].Logo" class="w-full h-full object-contain" alt="Rank 3">
                    </div>
                    <h3 class="font-bold mb-4 text-2xl text-white">@Model.Companies[2].Name</h3>

                    <div class="relative w-full flex flex-col items-center">
                        <div
                            class="absolute top-5 z-30 podium-gradient-bronze p-3 rounded-xl shadow-lg border border-white/10">
                            <iconify-icon icon="ph:trophy-fill" class="text-white text-3xl block"></iconify-icon>
                        </div>

                        <div class="podium-gradient-bronze h-14 w-full podium-top"></div>
                        <div
                            class="podium-gradient-bronze w-full pt-10 pb-8 h-96 flex flex-col items-center justify-between text-white shadow-xl relative">
                            <span class="font-bold opacity-90">@Model.Companies[2].VacancyCount Elan</span>
                            <span class="text-8xl font-bold mb-20">3</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="text-left w-full mt-20 px-36">
                <div class="flex flex-col md:flex-row justify-end items-end md:items-center mb-4 gap-4">
                    <div class="relative w-full md:w-80">
                        <span class="absolute left-4 top-1/2 -translate-y-1/2 opacity-50 text-white mt-1">
                            <iconify-icon icon="ph:magnifying-glass"></iconify-icon>
                        </span>
                        <input type="text"
                               name="search"
                               placeholder="Şirkət axtar..."
                               class="w-full pl-11 pr-4 py-3 rounded-xl outline-none bg-white/5 border border-white/10 text-white transition focus:border-white/30 text-sm">
                    </div>
                </div>

                <div class="w-full overflow-x-auto">
                    <table class="w-full border-separate border-spacing-y-3">
                        <thead class="text-white opacity-90 text-sm tracking-wider">
                        <tr>
                            <th class="px-8 font-semibold text-left">Sıra</th>
                            <th class="font-semibold text-left">Şirkət</th>
                            <th class="font-semibold text-center">Elanlar</th>
                            <th class="font-semibold text-center">Baxışlar</th>
                            <th class="px-8 font-semibold text-right">Artım</th>
                        </tr>
                        </thead>
                        <tbody>
                        @for (int i = 3; i < Model.Companies.Count; i++)
                        {
                            var c = Model.Companies[i];
                            int displayRank = i + 1;

                            <tr class="bg-tableColor hover:bg-white/10 transition-all cursor-pointer shadow-lg group">
                                <td width="5"
                                    class="py-3 rounded-l-2xl font-bold text-center text-lg @(displayRank <= 10 ? "text-yellow-500" : "text-white/40")">
                                    @displayRank
                                </td>

                                <td class="py-3 col-span-2">
                                    <div class="flex items-center gap-4">
                                        <div
                                            class="w-10 h-10 rounded-full bg-white p-1 flex items-center justify-center overflow-hidden border border-white/10 shadow-sm">
                                            <img src="@c.Logo" class="w-full h-full object-contain" alt="@c.Name">
                                        </div>
                                        <span class="font-bold text-sm text-white tracking-wide">@c.Name</span>
                                        @if (c.IsVerified)
                                        {
                                            <iconify-icon icon="material-symbols:verified"
                                                          class="text-[#2D9CDB] -mx-3"></iconify-icon>
                                        }
                                    </div>
                                </td>

                                <td class="py-3 text-center text-sm font-semibold text-white">
                                    @c.VacancyCount <span class="text-[10px] opacity-50 block font-normal md:inline">Elan</span>
                                </td>

                                <td class="py-3 text-center text-sm font-semibold text-white hidden md:table-cell">
                                    @c.VacancyCount
                                </td>

                                <td class="py-3 pr-8 text-right rounded-r-2xl">
                                    <span
                                        class="bg-green-500/10 text-green-500 px-3 py-1.5 rounded-lg text-xs font-black">
                                        +1%
                                    </span>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="flex flex-1 justify-center mt-3">

                <button class="bg-lightGreen hover:bg-darkGreen px-10 py-4 text-white text-lg rounded-lg font-bold">
                    Daha Cox
                </button>
            </div>
        }
        else
        {
            <div class="py-20 opacity-50 text-white italic">Kifayət qədər məlumat tapılmadı.</div>
        }
    </div>

    @if (Layout != null)
    {
        @if (Model.Faqs != null && Model.Faqs.Count > 0)
        {
            <div class="text-center mb-12 mt-32">
                <h2 class="text-4xl font-black text-white mb-4">Tez-tez verilən suallar</h2>
                <p class="text-white/60 text-lg">Liderlərin reytinq cədvəli haqqında ən çox soruşulan suallar</p>
            </div>
        }

        <div class="space-y-4 mb-20 text-left px-36 mx-auto">
            @foreach (FaqDto faq in Model.Faqs)
            {
                <div class="faq-item border bg-tableColor border-lightGreen text-white rounded-2xl cursor-pointer"
                     onclick="this.classList.toggle('active')">
                    <div class="flex justify-between items-center p-6">
                        <h3 class="font-semibold text-sm md:text-base pr-4">@faq.Question</h3>
                        <iconify-icon icon="ph:caret-down-bold"
                                      class="text-[#1A998D] transition-transform duration-300"></iconify-icon>
                    </div>
                    <div class="faq-answer px-6 text-gray-400 text-sm leading-relaxed">
                        <div class="pb-6">@faq.Answer</div>
                    </div>
                </div>
            }

        </div>
        <div class="flex flex-col items-center mx-36 justify-center bg-tableColor border border-lightGreen text-white rounded-2xl p-12">
            <p class="text-xl mb-2">Cavabınızı tapa bilmədiniz?</p>
    
            <p class="text-md opacity-60 mb-8 text-center max-w-md">
                Dəstək komandamız sizə kömək etməkdən məmnun olacaq
            </p>
    
            <a href="/contact" class="transition-transform hover:scale-105 active:scale-95">
                <button class="bg-lightGreen hover:bg-darkGreen px-10 py-4 text-white text-lg rounded-xl font-bold shadow-lg transition-colors">
                    Bizimlə əlaqə saxlayın
                </button>
            </a>
        </div>
    }
</div>

@if (Layout != null)
{
    @section Scripts {
        <script>
            window.updateTabClasses = function (clickedElement) {
                const buttons = document.querySelectorAll('.filter-btn');
                buttons.forEach(btn => {
                    btn.classList.remove('btn-active', 'text-white', 'font-semibold');
                    btn.classList.add('opacity-60', 'font-medium');
                });
                clickedElement.classList.add('btn-active', 'text-white', 'font-semibold');
                clickedElement.classList.remove('opacity-60', 'font-medium');
            }
        </script>
    }
}
