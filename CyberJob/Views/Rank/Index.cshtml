@using CyberJob.DTOs

@{
    var isHtmx = Context.Request.Headers.ContainsKey("HX-Request");
    Layout = isHtmx ? null : "_Layout";
}

@if (!isHtmx)
{
    @section Styles {
        <link rel="stylesheet" href="~/css/rank.css"/>
    }
}

<div class="w-full mx-auto pt-8 sm:pt-16 bg-cyberMain dark:bg-black transition-colors duration-300">

    @if (Layout != null)
    {
        <h1 class="text-3xl sm:text-5xl flex justify-center text-white font-semibold mb-10 sm:mb-16 tracking-tight px-4 text-center">
            @Localizer["rank.hero.title"]</h1>

        <div class="grid grid-cols-1 sm:grid-cols-3 mb-16 sm:mb-20 gap-8 sm:gap-0">
            <div class="flex flex-col items-center relative group px-4">

                <div
                    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-48 h-48 bg-[#14516D]/60 rounded-full blur-[50px] opacity-80 group-hover:opacity-100 transition-opacity"></div>

                <img src="~/images/winner.png" class="relative z-10 h-48 sm:h-72 mb-4 sm:mb-6 drop-shadow-2xl"
                     alt="Winner">

                <p class="relative z-10 text-sm sm:text-md text-white leading-relaxed max-w-[260px] text-center px-2">
                    @Localizer["rank.hero.winner_prefix"] <span class="font-bold">@Localizer["rank.hero.winner_badge"]</span> @Localizer["rank.hero.winner_suffix"]
                </p>
            </div>
            <div class="flex flex-col items-center relative group px-4">

                <div
                    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-48 h-48 bg-[#14516D]/60 rounded-full blur-[50px] opacity-80 group-hover:opacity-100 transition-opacity"></div>

                <img src="~/images/fly.png" class="relative z-10 h-48 sm:h-72 mb-4 sm:mb-6 drop-shadow-2xl" alt="Fly">

                <p class="relative z-10 text-sm sm:text-md text-white leading-relaxed max-w-[260px] text-center px-2">
                    @Localizer["rank.hero.active"]
                </p>
            </div>
            <div class="flex flex-col items-center relative group px-4">

                <div
                    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-48 h-48 bg-[#14516D]/60 rounded-full blur-[50px] opacity-80 group-hover:opacity-100 transition-opacity"></div>

                <img src="~/images/strong.png" class="relative z-10 h-48 sm:h-72 mb-4 sm:mb-6 drop-shadow-2xl"
                     alt="Strong">

                <p class="relative z-10 text-sm sm:text-md text-white leading-relaxed max-w-[260px] text-center px-2">
                    @Localizer["rank.hero.compete"]
                </p>
            </div>
        </div>

        <div class="relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] w-screen leading-[0] -mt-32 sm:-mt-48">
            <svg viewBox="0 0 1440 200" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto">
                <defs>
                    <filter id="colorGlow" x="-20%" y="-20%" width="140%" height="300%">
                        <feDropShadow dx="0" dy="8" stdDeviation="6" flood-color="#14516D" flood-opacity="0.7"/>
                    </filter>
                </defs>

                <path d="M0 20C360 200 1080 200 1440 20"
                      stroke="#14516D"
                      stroke-width="4"
                      stroke-linecap="round"
                      fill="none"
                      filter="url(#colorGlow)"/>
            </svg>
        </div>

        string currentDate = Context.Request.Query["date"].ToString();
        if (string.IsNullOrEmpty(currentDate)) currentDate = "this_month";

        string activeClass = "bg-zinc-800 text-white font-semibold";
        string inactiveClass = "opacity-60 font-medium hover:opacity-100 transition";

        <div class="w-full flex justify-center  md:-mt-6 sm:-mt-24">
            <div
                class="inline-flex bg-black/40 backdrop-blur-md p-1 rounded-2xl mb-16 sm:mb-28 shadow-2xl border border-white/10 overflow-x-auto">
                <button hx-get="/rank?date=this_month" hx-target="#company-list-container" hx-push-url="true"
                        hx-on:click="updateTabClasses(this)"
                        class="filter-btn px-6 sm:px-16 py-2 sm:py-2.5 rounded-xl text-xs sm:text-sm text-white whitespace-nowrap @(currentDate == "this_month" ? activeClass : inactiveClass)">
                    @Localizer["rank.filter.monthly"]
                </button>

                <button hx-get="/rank?date=last_month" hx-target="#company-list-container" hx-push-url="true"
                        hx-on:click="updateTabClasses(this)"
                        class="filter-btn px-6 sm:px-16 py-2 sm:py-2.5 rounded-xl text-xs sm:text-sm text-white whitespace-nowrap @(currentDate == "last_month" ? activeClass : inactiveClass)">
                    @Localizer["rank.filter.last_month"]
                </button>

                <button hx-get="/rank?date=all_time" hx-target="#company-list-container" hx-push-url="true"
                        hx-on:click="updateTabClasses(this)"
                        class="filter-btn px-6 sm:px-16 py-2 sm:py-2.5 rounded-xl text-xs sm:text-sm text-white whitespace-nowrap @(currentDate == "all_time" ? activeClass : inactiveClass)">
                    @Localizer["rank.filter.all_time"]
                </button>
            </div>
        </div>
    }


    <div id="company-list-container">
        @if (Model.Companies != null && Model.Companies.Count >= 3)
        {
            <div class="flex flex-row items-end justify-center gap-2 sm:gap-8 md:gap-12 px-2 mx-auto mb-16 sm:mb-32 sm:px-8 lg:px-36">

                <div class="w-1/3 flex flex-col items-center relative order-2 md:order-1">
                    <div
                        class="w-16 h-16 sm:w-40 sm:h-40 md:w-48 md:h-48 rounded-full bg-white p-1 border-[3px] sm:border-[6px] border-slate-400 mb-2 sm:mb-4 overflow-hidden shadow-lg">
                        <img src="@Model.Companies[1].Logo" class="w-full h-full object-cover" alt="Rank 2">
                    </div>
                    <h3 class="font-bold mb-1 sm:mb-4 text-[10px] sm:text-xl md:text-2xl text-white text-center truncate w-full">@Model.Companies[1].Name</h3>

                    <div class="relative w-full flex flex-col items-center">
                        <div
                            class="absolute top-3 sm:top-5 z-30 podium-gradient-silver p-1 sm:p-3 rounded-lg sm:rounded-xl shadow-lg border border-white/20">
                            <iconify-icon icon="ph:trophy-fill"
                                          class="text-white text-sm sm:text-3xl block"></iconify-icon>
                        </div>
                        <div class="podium-gradient-silver h-6 sm:h-14 w-full podium-top"></div>
                        <div
                            class="podium-gradient-silver w-full pt-4 sm:pt-10 pb-4 sm:pb-12 h-32 sm:h-72 md:h-96 flex flex-col items-center justify-between text-white shadow-xl relative">
                            <span
                                class="font-bold opacity-90 text-[8px] sm:text-base">@Model.Companies[1].VacancyCount @Localizer["rank.announcement"]</span>
                            <span class="text-xl sm:text-7xl md:text-8xl font-bold mb-4 sm:mb-20">2</span>
                        </div>
                    </div>
                </div>

                <div class="w-1/3 flex flex-col items-center z-20 scale-100 md:mb-20 order-1 md:order-2">
                    <div
                        class="w-20 h-20 sm:w-48 sm:h-48 rounded-full bg-white p-1 border-[4px] sm:border-[8px] border-yellow-500 mb-2 sm:mb-4 overflow-hidden shadow-[0_0_20px_rgba(234,179,8,0.4)]">
                        <img src="@Model.Companies[0].Logo" class="w-full h-full object-contain" alt="Rank 1">
                    </div>
                    <h3 class="font-bold mb-1 sm:mb-4 text-[10px] sm:text-xl md:text-2xl text-white text-center truncate w-full">@Model.Companies[0].Name</h3>

                    <div class="relative w-full flex flex-col items-center">
                        <div
                            class="absolute top-5 z-30 podium-gradient-gold p-1.5 sm:p-4 rounded-lg sm:rounded-xl shadow-lg border border-yellow-200/50">
                            <iconify-icon icon="ph:trophy-fill"
                                          class="text-white text-base sm:text-4xl block"></iconify-icon>
                        </div>
                        <div class="podium-gradient-gold h-8 sm:h-14 w-full podium-top"></div>
                        <div
                            class="podium-gradient-gold w-full pt-6 sm:pt-12 pb-6 sm:pb-14 h-40 sm:h-72 md:h-96 flex flex-col items-center justify-between text-white shadow-2xl relative">
                            <span class="font-bold text-[8px] sm:text-lg">@Model.Companies[0].VacancyCount @Localizer["rank.announcement"]</span>
                            <span class="text-2xl sm:text-8xl md:text-9xl font-bold mb-6 sm:mb-20">1</span>
                        </div>
                    </div>
                </div>

                <div class="w-1/3 flex flex-col items-center relative order-3">
                    <div
                        class="w-16 h-16 sm:w-40 sm:h-40 md:w-48 md:h-48 rounded-full bg-white p-1 border-[3px] sm:border-[6px] border-orange-700 mb-2 sm:mb-4 overflow-hidden shadow-lg">
                        <img src="@Model.Companies[2].Logo" class="w-full h-full object-contain" alt="Rank 3">
                    </div>
                    <h3 class="font-bold mb-1 sm:mb-4 text-[10px] sm:text-xl md:text-2xl text-white text-center truncate w-full">@Model.Companies[2].Name</h3>

                    <div class="relative w-full flex flex-col items-center">
                        <div
                            class="absolute top-3 sm:top-5 z-30 podium-gradient-bronze p-1 sm:p-3 rounded-lg sm:rounded-xl shadow-lg border border-white/10">
                            <iconify-icon icon="ph:trophy-fill"
                                          class="text-white text-sm sm:text-3xl block"></iconify-icon>
                        </div>
                        <div class="podium-gradient-bronze h-6 sm:h-14 w-full podium-top"></div>
                        <div
                            class="podium-gradient-bronze w-full pt-4 sm:pt-10 pb-4 sm:pb-8 h-32 sm:h-72 md:h-96 flex flex-col items-center justify-between text-white shadow-xl relative">
                            <span
                                class="font-bold opacity-90 text-[8px] sm:text-base">@Model.Companies[2].VacancyCount @Localizer["rank.announcement"]</span>
                            <span class="text-xl sm:text-7xl md:text-8xl font-bold mb-4 sm:mb-20">3</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="text-left w-full mt-8 sm:mt-20 px-4 sm:px-8 lg:px-36">
                <div class="flex flex-col md:flex-row justify-end items-end md:items-center mb-4 gap-4">
                    <div class="relative w-full md:w-80">
                        <span class="absolute left-4 top-1/2 -translate-y-1/2 opacity-50 text-white mt-0.5">
                            <iconify-icon icon="ph:magnifying-glass"></iconify-icon>
                        </span>
                        <input type="text"
                               name="search"
                               placeholder="@Localizer["rank.search_placeholder"]"
                               class="w-full pl-10 sm:pl-11 pr-4 py-2.5 sm:py-3 rounded-xl outline-none bg-white/5 border border-white/10 text-white transition focus:border-white/30 text-sm">
                    </div>
                </div>

                <div class="w-full overflow-x-auto">
                    <table
                        class="w-full border-separate border-spacing-y-2 sm:border-spacing-y-3 min-w-[600px] sm:min-w-0">
                        <thead class="text-white opacity-90 text-xs sm:text-sm tracking-wider">
                        <tr>
                            <th class="px-3 sm:px-8 font-semibold text-left">@Localizer["rank.rank"]</th>
                            <th class="font-semibold text-left">@Localizer["rank.company"]</th>
                            <th class="font-semibold text-center">@Localizer["rank.vacancies"]</th>
                            <th class="font-semibold text-center hidden sm:table-cell">@Localizer["rank.views"]</th>
                            <th class="px-3 sm:px-8 font-semibold text-right">@Localizer["rank.growth"]</th>
                        </tr>
                        </thead>
                        <tbody>
                        @for (int i = 3; i < Model.Companies.Count; i++)
                        {
                            var c = Model.Companies[i];
                            int displayRank = i + 1;

                            <tr class="bg-tableColor/80 hover:bg-tableColor transition-all cursor-pointer shadow-lg group">
                                <td width="5"
                                    class="py-2 sm:py-3 rounded-l-2xl font-bold text-center text-sm sm:text-lg @(displayRank <= 10 ? "text-yellow-500" : "text-white/40")">
                                    @displayRank
                                </td>

                                <td class="py-2 sm:py-3">
                                    <div class="flex items-center gap-2 sm:gap-4">
                                        <div
                                            class="w-7 h-7 sm:w-10 sm:h-10 rounded-full bg-white p-0.5 sm:p-1 flex items-center justify-center overflow-hidden border border-white/10 shadow-sm shrink-0">
                                            <img src="@c.Logo" class="w-full h-full object-contain" alt="@c.Name">
                                        </div>
                                        <span
                                            class="font-bold text-xs sm:text-sm text-white tracking-wide truncate max-w-[120px] sm:max-w-none">@c.Name</span>
                                        @if (c.IsVerified)
                                        {
                                            <iconify-icon icon="material-symbols:verified"
                                                          class="text-[#2D9CDB] -ml-1 sm:-mx-3 shrink-0"></iconify-icon>
                                        }
                                    </div>
                                </td>

                                <td class="py-2 sm:py-3 text-center text-xs sm:text-sm font-semibold text-white">
                                    @c.VacancyCount <span class="text-[10px] opacity-50 block font-normal sm:inline">@Localizer["rank.announcement"]</span>
                                </td>

                                <td class="py-2 sm:py-3 text-center text-xs sm:text-sm font-semibold text-white hidden sm:table-cell">
                                    @c.VacancyCount
                                </td>

                                <td class="py-2 sm:py-3 pr-3 sm:pr-8 text-right rounded-r-2xl">
                                    <span
                                        class="bg-green-500/10 text-green-500 px-2 sm:px-3 py-1 sm:py-1.5 rounded-lg text-[10px] sm:text-xs font-black whitespace-nowrap">
                                        +1%
                                    </span>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="flex justify-center mt-4 sm:mt-3 pb-8 sm:pb-0">

                <a asp-controller="Company" asp-action="Index"
                    class="bg-lightGreen hover:bg-darkGreen px-8 sm:px-10 py-3 sm:py-4 text-white text-base sm:text-lg rounded-lg font-bold">
                    @Localizer["rank.more_button"]
                </a>
            </div>
        }
        else
        {
            <div class="py-16 sm:py-20 opacity-50 text-white italic text-center px-4">@Localizer["rank.no_data"]
            </div>
        }
    </div>

    @if (Layout != null)
    {
        @if (Model.Faqs != null && Model.Faqs.Count > 0)
        {
            <div class="text-center mb-8 sm:mb-12 mt-16 sm:mt-32 px-4">
                <h2 class="text-2xl sm:text-4xl font-black text-white mb-3 sm:mb-4">@Localizer["rank.faq_title"]</h2>
                <p class="text-white/60 text-base sm:text-lg">@Localizer["rank.faq_subtitle"]</p>
            </div>
        }

        <div class="space-y-4 mb-16 sm:mb-20 text-left px-4 sm:px-8 lg:px-36 mx-auto ">
            @foreach (FaqDto faq in Model.Faqs)
            {
                <div class="faq-item border bg-tableColor border-lightGreen text-white rounded-2xl cursor-pointer"
                     onclick="this.classList.toggle('active')">
                    <div class="flex justify-between items-center p-4 sm:p-6">
                        <h3 class="font-semibold text-sm sm:text-base pr-4">@faq.Question</h3>
                        <iconify-icon icon="ph:caret-down-bold"
                                      class="text-[#1A998D] transition-transform duration-300 shrink-0"></iconify-icon>
                    </div>
                    <div class="faq-answer px-4 sm:px-6 text-gray-400 text-sm sm:text-sm leading-relaxed">
                        <div class="pb-4 sm:pb-6">@faq.Answer</div>
                    </div>
                </div>
            }

        </div>
        <div
            class="flex flex-col items-center mx-4 sm:mx-8 lg:mx-36 justify-center bg-tableColor border border-lightGreen text-white rounded-2xl p-6 sm:p-12">
            <p class="text-lg sm:text-xl mb-2">@Localizer["rank.help_title"]</p>

            <p class="text-sm sm:text-md opacity-60 mb-6 sm:mb-8 text-center max-w-md">
                @Localizer["rank.help_subtitle"]
            </p>

            <a asp-controller="StaticPage" asp-action="Contact" class="transition-transform hover:scale-105 active:scale-95">
                <button
                    class="bg-lightGreen hover:bg-darkGreen px-8 sm:px-10 py-3 sm:py-4 text-white text-base sm:text-lg rounded-xl font-bold shadow-lg transition-colors">
                    @Localizer["rank.contact_button"]
                </button>
            </a>
        </div>
    }
</div>

@if (Layout != null)
{
    @section Scripts {
        <script>
            window.updateTabClasses = function (clickedElement) {
                const buttons = document.querySelectorAll('.filter-btn');
                buttons.forEach(btn => {
                    btn.classList.remove('btn-active', 'text-white', 'font-semibold');
                    btn.classList.add('opacity-60', 'font-medium');
                });
                clickedElement.classList.add('btn-active', 'text-white', 'font-semibold');
                clickedElement.classList.remove('opacity-60', 'font-medium');
            }
        </script>
    }
}
