@{
    ViewData["Title"] = Localizer["notfound.title"];
}

<div class="min-h-[70vh] flex items-center justify-center px-4 sm:px-8">
    <div class="text-center max-w-2xl mx-auto">
        <!-- 404 Text -->
        <div class="relative mb-10">
            <div class="text-[140px] sm:text-[200px] font-black leading-none tracking-tighter select-none">
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyberGreen to-lightGreen">4</span>
                <span class="text-transparent bg-clip-text bg-gradient-to-b from-gray-300 to-gray-500 dark:from-gray-600 dark:to-gray-800">0</span>
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-lightGreen to-cyberGreen">4</span>
            </div>
            <!-- Decorative elements -->
            <div class="absolute -top-4 -right-4 sm:-top-8 sm:-right-8 text-gray-200 dark:text-gray-800 select-none">
                <iconify-icon icon="ph:hexagon" class="text-6xl sm:text-8xl opacity-30"></iconify-icon>
            </div>
            <div class="absolute -bottom-2 -left-2 sm:-bottom-4 sm:-left-4 text-gray-200 dark:text-gray-800 select-none">
                <iconify-icon icon="ph:hexagon" class="text-4xl sm:text-6xl opacity-20"></iconify-icon>
            </div>
        </div>

        <!-- Robot / Error illustration -->
        <div class="flex justify-center mb-8">
            <div class="relative">
                <div class="w-28 h-28 sm:w-36 sm:h-36 rounded-full bg-gray-100 dark:bg-zinc-900 border-2 border-gray-200 dark:border-zinc-800 flex items-center justify-center">
                    <iconify-icon icon="ph:robot" class="text-6xl sm:text-7xl text-gray-300 dark:text-gray-600"></iconify-icon>
                </div>
                <!-- Small question mark above -->
                <div class="absolute -top-2 -right-2 w-10 h-10 rounded-full bg-cyberGreen/10 border border-cyberGreen/20 flex items-center justify-center">
                    <iconify-icon icon="ph:question" class="text-xl text-cyberGreen"></iconify-icon>
                </div>
            </div>
        </div>

        <!-- TEMPORARY diagnostic: show which URL produced this 404 -->
        <div class="inline-flex items-center gap-2 bg-red-100 dark:bg-red-900/30 border border-red-300 dark:border-red-800 rounded-full px-4 py-1.5 mb-6">
            <span class="text-xs font-semibold text-red-700 dark:text-red-300 uppercase tracking-wider">404 path:</span>
            <span class="text-sm font-mono font-bold text-red-800 dark:text-red-200">@(ViewBag.OriginalPath)</span>
        </div>

        <!-- Error Code Badge -->
        <div class="inline-flex items-center gap-2 bg-gray-100 dark:bg-zinc-900 border border-gray-200 dark:border-zinc-800 rounded-full px-4 py-1.5 mb-6">
            <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider">@Localizer["notfound.error_code"]:</span>
            <span class="text-sm font-bold text-gray-700 dark:text-gray-300">404</span>
        </div>

        <!-- Message -->
        <h1 class="text-3xl sm:text-4xl font-bold dark:text-white mb-4">@Localizer["notfound.title"]</h1>
        <p class="text-gray-500 dark:text-gray-400 text-base sm:text-lg mb-2">@Localizer["notfound.subtitle"]</p>
        <p class="text-gray-400 dark:text-gray-500 text-sm sm:text-base mb-10">@Localizer["notfound.desc"]</p>

        <!-- Home Button -->
        <a href="/"
           class="inline-flex items-center gap-3 bg-cyberGreen hover:bg-darkGreen text-white font-bold px-8 py-4 rounded-2xl transition-all shadow-lg shadow-emerald-900/20 group">
            <iconify-icon icon="ph:house-bold" class="text-xl group-hover:-translate-y-0.5 transition-transform"></iconify-icon>
            <span>@Localizer["notfound.home"]</span>
        </a>
    </div>
</div>
