@using CyberJob.DTOs
@model CyberJob.Models.HomeIndexVM

@section Styles {
    <link rel="stylesheet" href="~/css/home.css"/>
}

@{
    var heroBg = Model.HeroBanner?.Image != null
        ? $"background-image: url('{Model.HeroBanner.Image}');background-size: cover;background-position: center;"
        : "background-image: url('@Url.Content(\"~/images/hero.svg\")');background-size: 55%;background-position: right -5% center;";

    string RenderFaIcon(string? icon)
    {
        if (string.IsNullOrEmpty(icon)) return "fa-solid fa-layer-group";
        if (icon.Contains("heroicon")) return "fa-solid fa-layer-group";
        // Convert "fas-display" to "fas fa-display"
        var parts = icon.Split('-', 2);
        return parts.Length == 2 ? $"{parts[0]} fa-{parts[1]}" : icon;
    }
}

<section class="relative pt-16 sm:pt-[220px] pb-16 sm:pb-32 px-4 sm:px-8 overflow-hidden bg-[#0B2036] dark:bg-black"
         style="@heroBg
         background-repeat: no-repeat;
         background-size: cover;
         background-position: center;">

    <div class="absolute inset-0 bg-black/40 pointer-events-none z-0"></div>

    @if (Model.HeroBanner?.Link != null)
    {
        <a href="@Model.HeroBanner.Link" target="_blank" rel="noopener noreferrer"
           class="absolute inset-0 z-[1]"></a>
    }

    <div
        class="absolute left-[25%] bottom-[10%] w-[500px] h-[500px] bg-cyberGreen/20 rounded-full blur-[120px] pointer-events-none z-0"></div>

    <div class="max-w-[1600px] mx-auto relative z-10">
        <div class="max-w-4xl mb-8 sm:mb-12">
            <h1 style="font-size: clamp(28px, 5vw, 48px); line-height: 1.1;" class="mb-4 font-bold text-white">
                @Localizer["home.hero.title"]
            </h1>
            <p style="font-size: clamp(16px, 2.5vw, 24px); line-height: 1.4;" class="font-normal text-white">
                @Localizer["home.hero.subtitle"]
            </p>
        </div>

        <!-- Input Container -->
        <form action="/vacancies" method="get"
              class="w-full max-w-[1200px] bg-transparent md:bg-white rounded-xl border border-gray-200 p-1.5 flex flex-row items-center transition-all border-white/10 shadow-2xl relative z-20">
            <div
                class="flex-1 flex items-center px-3 sm:px-6 bg-transparent sm:bg-gray-100 mx-2 rounded-xl border border-transparent focus-within:border-cyberGreen/30 transition-all">
                <iconify-icon icon="ph:magnifying-glass"
                              class="text-gray-400 text-xl sm:text-2xl mr-2 sm:mr-3 shrink-0"></iconify-icon>
                <input type="text" name="search" placeholder="@Localizer["home.search.placeholder"]"
                       class="w-full py-3 sm:py-4 text-gray-700 focus:outline-none text-base sm:text-lg font-medium bg-transparent placeholder:text-gray-400">
            </div>

            <button type="submit"
                    class="flex items-center justify-center gap-2 bg-extraLightGreen text-white font-bold px-6 sm:px-32 py-3 sm:py-4 rounded-xl transition-all hover:bg-cyberGreen active:scale-95 text-base sm:text-lg whitespace-nowrap">

                <i class="fa-solid fa-magnifying-glass text-2xl sm:hidden"></i>

                <span class="hidden sm:inline">@Localizer["home.search.button"]</span>
            </button>
        </form>

        <div class="w-full max-w-[730px] mt-4 sm:mt-6 ml-0 sm:ml-[122px] relative z-20 hidden sm:block">
            <div class="flex items-center gap-2 sm:gap-[23px] overflow-x-auto pb-2 scrollbar-hide">
                @if (Model.Categories is not null)
                {
                    @foreach (var bCat in Model.Categories)
                    {
                        <a href="/vacancies?CategoryId=@bCat.Id"
                           class="flex items-center justify-center gap-2 border border-white rounded-[8px] text-white text-[13px] sm:text-[15px] font-medium hover:bg-white hover:text-black hover:border-white transition-all shrink-0 px-4 sm:px-6 py-2 sm:py-3 h-auto ">
                            @if (!string.IsNullOrEmpty(bCat.Icon))
                            {
                                <i class="@RenderFaIcon(bCat.Icon) text-xs sm:text-sm"></i>
                            }
                            @bCat.Name
                        </a>
                    }

                    <a asp-controller="Vacancy" asp-action="Index"
                       class="flex items-center justify-center border border-white rounded-[8px] text-white text-[13px] sm:text-[15px] font-medium hover:bg-white hover:text-black hover:border-white transition-all shrink-0 px-4 sm:px-6 py-2 sm:py-3 h-auto ">
                        @Localizer["home.categories.more"]
                    </a>
                }
            </div>
        </div>
    </div>
</section>
<section
    class="flex flex-col items-center font-sans text-black dark:text-white rounded-t-[40px] transition-colors duration-500">

    <div class="py-5 sm:py-10 bg-gray-400 w-full overflow-hidden transition-colors duration-500">
        <div class="swiper banner-swiper w-full max-w-[1440px] mx-auto px-4">
            <div class="swiper-wrapper">
                @foreach (var banner in Model.Banners.Where(b => b.Location == "medium"))
                {
                    <div class="swiper-slide">
                        <img src="@banner.Image" alt="">
                    </div>
                }
            </div>
            <div class="swiper-pagination"></div>
        </div>
    </div>

    <div
        class="w-full max-w-[1600px] px-4 grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-[20px] mt-3 mx-auto">
        <h2 class="col-span-full text-[22px] sm:text-[32px] font-bold text-center dark:text-white mb-2 sm:mb-4">
            @Localizer["home.categories.title"]
        </h2>
        @if (Model.Categories != null)
        {
            @foreach (var category in Model.Categories)
            {
                <a href="/vacancies?CategoryId=@category.Id"
                   class="w-full min-h-[80px] sm:h-[100px] border-2 border-gray-200 dark:border-gray-800 shadow-sm rounded-2xl flex flex-col items-center justify-center gap-1 sm:gap-2 hover:border-[#00D4AA] cursor-pointer bg-white dark:bg-black group transition-all p-2">

                    <div class="flex items-center justify-center">
                        @if (!string.IsNullOrEmpty(category.Icon))
                        {
                            <i class="@RenderFaIcon(category.Icon) text-2xl sm:text-3xl text-cyberGreen group-hover:text-[#00D4AA] transition-all"></i>
                        }
                        else
                        {
                            <i class="fa-solid fa-layer-group text-2xl sm:text-3xl text-cyberGreen group-hover:text-[#00D4AA] transition-all"></i>
                        }
                    </div>

                    <span
                        class="text-[11px] sm:text-sm font-medium text-gray-700 dark:text-gray-300 group-hover:text-black dark:group-hover:text-white transition-colors text-center">
                @category.Name
            </span>
                </a>
            }
        }
    </div>

    <h2 class="text-2xl sm:text-3xl font-bold mt-10 sm:mt-16 mb-6 sm:mb-8 dark:text-white text-center">@Localizer["home.premium.title"]</h2>
    <div id="premium-ads-container"
         class="w-full max-w-[1600px] mx-auto px-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 mb-8 sm:mb-20">
        @foreach (var vacancy in Model.PremiumVacancies)
        {
            <a href="/vacancies/@vacancy.Id"
               class="w-full premium-card-border min-h-[80px] flex flex-col relative group hover:-translate-y-1 transition-all dark:bg-black">
                <div
                    class="bg-white dark:bg-black rounded-[14px] p-3 md:p-4 h-full flex flex-col justify-between relative transition-colors border border-gray-100 dark:border-gray-800">
                    <div
                        class="premium-badge-gradient absolute top-0 right-2 sm:right-auto sm:top-2 sm:left-1/2 sm:-translate-x-1/2 px-3 sm:px-6 py-1 sm:py-2 rounded-b-2xl sm:rounded-full text-white text-[10px] sm:text-sm font-bold uppercase z-10 shadow-sm">
                        @Localizer["home.premium.badge"]
                    </div>

                    <div class="flex items-start gap-2.5 my-2 sm:mt-12 overflow-hidden">
                        <div class="size-14 sm:size-16 lg:size-10 rounded-full sm:rounded-md overflow-hidden shrink-0">
                            <img src="@vacancy.Company.Logo" alt="@vacancy.Company.Name"
                                 class="w-full h-full object-cover"/>
                        </div>
                        <div class="min-w-0 flex-1">
                            <h3 class="text-sm sm:text-md font-bold text-black dark:text-white leading-tight truncate">@vacancy.Name</h3>
                            <div class="mt-2 sm:mt-4 lg:mt-1 flex items-center justify-between w-full">
                                    <span
                                        class="text-xs sm:text-md text-gray-400 font-semibold truncate flex items-center gap-1">
                                        @vacancy.Company.Name
                                        @if (vacancy.Company.IsVerified)
                                        {
                                            <iconify-icon icon="material-symbols:verified"
                                                          class="text-[#2D9CDB] shrink-0"></iconify-icon>
                                        }
                                    </span>
                            </div>
                        </div>
                    </div>

                    <div class="mt-auto hidden sm:block">
                        <div class="w-full h-[0.5px] bg-gray-400/20 dark:bg-gray-800/40 mb-2"></div>
                        <div class="flex justify-between items-center text-gray-400 text-xs sm:text-sm">
                                <span class="flex items-center gap-1"><i
                                        class="fa-regular fa-clock text-md"></i> @vacancy.CreatedAt?.ToString("dd.MM.yyyy")</span>
                            <span class="flex items-center gap-1"><i
                                    class="fa-regular fa-eye text-md"></i> @vacancy.ViewCount</span>
                            <span class="text-[#B7872B] font-bold ">@vacancy.Salary</span>
                        </div>
                    </div>
                </div>
            </a>
        }
    </div>

    <h2 class="text-2xl sm:text-3xl font-bold mb-5 sm:mb-9 dark:text-white">@Localizer["home.latest.title"]</h2>
    <div id="latest-jobs-container"
         class="w-full max-w-[1600px] mx-auto px-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2 sm:gap-[10px] mb-8 sm:mb-10">

        @foreach (var vacancy in Model.LatestVacancies)
        {
            <a href="/vacancies/@vacancy.Id"
               class="border border-gray-300 sm:border-gray-400 dark:border-gray-700 dark:bg-[#0a0a0a] min-h-[80px] flex flex-col relative px-3 sm:p-4 transition-all hover:-translate-y-1 shadow-sm rounded-2xl">
                <div class="flex items-start gap-2.5 my-2 sm:mt-3 overflow-hidden">
                    <div class="size-14 sm:size-16 lg:size-10 rounded-full sm:rounded-md overflow-hidden shrink-0">
                        <img src="@vacancy.Company.Logo" alt="@vacancy.Company.Name"
                             class="w-full h-full object-cover"/>
                    </div>
                    <div class="min-w-0 flex-1">
                        <h3 class="text-sm sm:text-[16px] font-bold text-black dark:text-white leading-tight truncate">@vacancy.Name</h3>
                        <div class="mt-2 sm:mt-4 lg:mt-1 flex items-center justify-between w-full">
                                <span
                                    class="text-xs sm:text-md text-gray-400 font-semibold truncate flex items-center gap-1">
                                    @vacancy.Company.Name
                                    @if (vacancy.Company.IsVerified)
                                    {
                                        <iconify-icon icon="material-symbols:verified"
                                                      class="text-[#2D9CDB] shrink-0"></iconify-icon>
                                    }
                                </span>
                        </div>
                    </div>
                </div>
                <div class="mt-auto">
                    <div class="w-full h-[0.5px] bg-gray-400/20 dark:bg-gray-800/40 mb-2"></div>
                    <div class="flex justify-between items-center text-gray-400 text-xs sm:text-sm">
                        <span class="flex items-center gap-1"><i
                                class="fa-regular fa-clock"></i> @vacancy.CreatedAt?.ToString("dd.MM.yyyy")</span>
                        <span class="flex items-center gap-1"><i
                                class="fa-regular fa-eye"></i> @vacancy.ViewCount</span>
                        <span class="text-darkGreen font-bold">@vacancy.Salary</span>
                    </div>
                </div>
            </a>
        }
    </div>

    <a asp-controller="Vacancy" asp-action="Index"
       class="px-16 sm:px-24 py-4 sm:py-5 bg-darkGreen text-white font-bold rounded-lg mb-8 sm:mb-10 transition-colors hover:bg-black text-base sm:text-lg">
        @Localizer["home.latest.more"]
    </a>

    @if (Model.Partners.Any())
    {
        <div class="w-full max-w-full px-4 sm:px-16">
            <h2 class="text-center text-2xl sm:text-4xl font-bold mb-6 text-black dark:text-white">@Localizer["home.partners.title"]</h2>
            <div class="w-full h-0.5 bg-gradient-to-r from-transparent via-lightGreen/60 to-transparent mb-6"></div>
            <div
                class="w-full inline-flex flex-nowrap overflow-hidden [mask-image:_linear-gradient(to_right,transparent_0,_black_128px,_black_calc(100%-128px),transparent_100%)]">
                <ul class="flex items-center justify-center md:justify-start [&_li]:mx-6 sm:[&_li]:mx-12 [&_img]:max-w-none animate-infinite-scroll">

                    @foreach (var partner in Model.Partners)
                    {
                        <li>
                            <img src="@partner.Image" class="h-10 sm:h-16 w-auto object-contain" alt=""/>
                        </li>
                    }

                    @foreach (var partner in Model.Partners)
                    {
                        <li>
                            <img src="@partner.Image" class="h-10 sm:h-16 w-auto object-contain" alt=""/>
                        </li>
                    }
                </ul>
            </div>
            <div class="w-full h-0.5 bg-gradient-to-r from-transparent via-lightGreen/60 to-transparent my-6"></div>

        </div>
    }

    <div class="w-full flex flex-col items-center pb-16 sm:pb-24 bg-gray-50 dark:bg-[#0a0a0a] mt-3">

        <h2 class="relative z-20 text-2xl sm:text-4xl font-bold mb-3 text-black dark:text-white">@Localizer["home.stats.title"]</h2>
        <div
            class="inline-flex bg-white dark:bg-cyberMain p-1 rounded-xl mb-8 sm:mb-16 border dark:border-gray-800 transition-colors relative z-20">
            <button onclick="switchStats('visitor')"
                    class="stat-tab px-6 sm:px-10 py-2 bg-lightGreen text-white rounded-lg text-xs sm:text-sm font-semibold shadow-sm"
                    id="tab-visitor">
                @Localizer["home.stats.visitor"]
            </button>
            <button onclick="switchStats('vacancy')"
                    class="stat-tab px-6 sm:px-10 py-2 text-gray-500 dark:text-gray-400 text-xs sm:text-sm font-semibold hover:text-cyberMain dark:hover:text-white transition-all"
                    id="tab-vacancy">
                @Localizer["home.stats.vacancy"]
            </button>
        </div>

        <div class="relative w-full flex flex-col items-center px-4 sm:px-10 py-3 mb-8 sm:mb-16">
            <img src="~/images/statisticBg.svg" alt=""
                 class="absolute inset-x-0 top-1/2 -translate-y-1/2 w-full h-auto opacity-70 pointer-events-none max-h-[200px] sm:max-h-none">

            <div class="flex flex-wrap justify-center gap-6 sm:gap-12 mt-10 sm:mt-14 relative z-10"
                 id="stats-container">
                <div class="text-center">
                    <p class="text-3xl sm:text-6xl font-bold dark:text-white mb-3 sm:mb-10 leading-none stat-value"
                       id="stat-daily">@Model.VisitorDaily</p>
                    <p class="text-[10px] sm:text-sm font-semibold uppercase tracking-widest dark:text-gray-300">@Localizer["home.stats.daily"]</p>
                </div>

                <div class="text-center">
                    <p class="text-3xl sm:text-6xl font-bold dark:text-white mb-3 sm:mb-10 leading-none stat-value"
                       id="stat-weekly">@Model.VisitorWeekly</p>
                    <p class="text-[10px] sm:text-sm font-semibold uppercase tracking-widest dark:text-gray-300">
                        @Localizer["home.stats.weekly"]</p>
                </div>

                <div class="text-center">
                    <p class="text-3xl sm:text-6xl font-bold dark:text-white mb-3 sm:mb-10 leading-none stat-value"
                       id="stat-monthly">@Model.VisitorMonthly</p>
                    <p class="text-[10px] sm:text-sm font-semibold uppercase tracking-widest dark:text-gray-300">
                        @Localizer["home.stats.monthly"]</p>
                </div>

                <div class="text-center">
                    <p class="text-3xl sm:text-6xl font-bold dark:text-white mb-3 sm:mb-10 leading-none stat-value"
                       id="stat-total">@Model.VisitorTotal</p>
                    <p class="text-[10px] sm:text-sm font-semibold uppercase tracking-widest dark:text-gray-300">@Localizer["home.stats.total"]</p>
                </div>
            </div>
        </div>

    </div>

    <section class="w-full flex justify-center px-4 mt-8 sm:mt-12">
        <div
            class="shadow-lg relative group w-full rounded-2xl overflow-hidden h-[200px] sm:h-[300px]">
            @foreach (var banner in Model.Banners)
            {
                @if (banner.Location == "large")
                {
                    <img src="@banner.Image"
                         class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                         alt="">
                    break;
                }
            }

        </div>
    </section>
    <partial name="../Sections/_Subscribe"/>

</section>


@section Scripts {
    <script>
        window._statsData = {
            visitorDaily: @Model.VisitorDaily,
            visitorWeekly: @Model.VisitorWeekly,
            visitorMonthly: @Model.VisitorMonthly,
            visitorTotal: @Model.VisitorTotal,
            vacancyDaily: @Model.VacancyDaily,
            vacancyWeekly: @Model.VacancyWeekly,
            vacancyMonthly: @Model.VacancyMonthly,
            vacancyTotal: @Model.VacancyTotal
        };
    </script>
    <script src="~/js/home.js"></script>
}
