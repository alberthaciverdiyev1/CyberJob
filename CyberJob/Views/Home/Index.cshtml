@using CyberJob.Helpers
@section Styles {
    <link rel="stylesheet" href="~/css/home.css" />
}
@{
    int bannerCount = 0;
}
    <section class="relative pt-24 pb-32 px-8 overflow-hidden">
        <div class="max-w-[1440px] mx-auto relative z-10">
            <div class="max-w-4xl mb-12">
                <h1 style="font-weight: 700; font-size: 48px; line-height: 52px; color: #E6E6E6;" class="mb-4">
                    Yeni imkanlar. Yeni karyera. Yeni sən!
                </h1>
                <p style="font-weight: 400; font-size: 24px; line-height: 32px; color: #CCCCCC;">
                    Gələcəyin IT karyerası buradan başlayır.
                </p>
            </div>

            <div style="width: 1009.47px; height: 74.83px;"
                 class="bg-white dark:bg-[#0a0a0a] rounded-lg p-2 flex items-center shadow-2xl transition-all">
                <div class="flex-1 flex items-center px-6 bg-gray-200 mx-2 rounded-lg">
                    <iconify-icon icon="ph:magnifying-glass" class="text-gray-400 text-2xl mr-3"></iconify-icon>
                    <input type="text" placeholder="Şirkət axtar..."
                           class="w-full py-4 text-gray-700 dark:text-gray-300 focus:outline-none text-lg font-medium bg-transparent placeholder:text-gray-400">
                </div>
                <button
                    class="bg-cyberGreen text-white font-bold px-12 h-full rounded-[16px] transition-all hover:bg-[#00bc96] active:scale-95 text-lg">
                    Axtar
                </button>
            </div>

            <div style="width: 730.60px; height: 54px; margin-top: 24px; margin-left: 122px;"
                 class="flex items-center gap-[23px] overflow-hidden">
                @if (Model.Categories is not null)
                {
                    @foreach (var bCat in Model.Categories)
                    {
                        <a href="#"
                           class="flex items-center justify-center border border-white rounded-[8px] text-white text-[15px] font-medium hover:bg-white hover:text-cyberMain transition-all shrink-0 px-6 h-full">@bCat.Name</a>
                    }
                }
            </div>
        </div>
    </section>

    <section
        class="flex flex-col items-center font-sans text-black dark:text-white rounded-t-[40px] transition-colors duration-500">

        <div class="banner-section dark:bg-cyberDark w-full transition-colors duration-500">
            <div class="banner-wrapper" id="slider-container">
                @foreach (var banner in Model.Banners)
                {
                    @if (banner.Location == "medium")
                    {
                        string slideClass = "";

                        if (bannerCount == 0) slideClass = "slide-left";
                        else if (bannerCount == 1) slideClass = "slide-right";
                        else if (bannerCount == 2) slideClass = "slide-main";
                        else slideClass = "slide-hidden";

                        <img src="@banner.Image"
                             class="banner-slide @slideClass"
                             alt="">

                        bannerCount++;
                    }
                }
            </div>
        </div>

        <div class="hidden sm:grid w-full max-w-[1445px] px-4 grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-[20px] mt-3 mx-auto">            <h2 class="col-span-full text-[32px] font-bold text-center dark:text-white mb-4">
                Hansı sahə üzrə axtarırsan?
            </h2>
            @if (Model.Categories != null)
            {
                @foreach (var category in Model.Categories)
                {
                    <div
                        class="w-full h-[100px] border-2 border-gray-200 dark:border-gray-800 shadow-sm rounded-2xl flex flex-col items-center justify-center gap-2 hover:border-[#00D4AA] cursor-pointer bg-white dark:bg-black group transition-all">

                        <div class="flex items-center justify-center">
                            @if (!string.IsNullOrEmpty(category.Icon))
                            {
                                @if (category.Icon.Contains("heroicon"))
                                {
                                    var iconName = category.Icon.Replace("heroicon-c-", "").Replace("heroicon-o-", "").Replace("heroicon-s-", "");
                                    var folder = category.Icon.Contains("-o-") ? "24/outline" : "20/solid";
                                    var iconUrl = $"https://raw.githubusercontent.com/tailwindlabs/heroicons/master/src/{folder}/{iconName}.svg";

                                    <span class="w-8 h-8 bg-cyberGreen group-hover:bg-[#00D4AA] transition-all"
                                          style="mask: url('@iconUrl') no-repeat center;
                                          -webkit-mask: url('@iconUrl') no-repeat center;
                                          mask-size: contain; -webkit-mask-size: contain;
                                          display: inline-block;">
                        </span>
                                }
                                else
                                {
                                    <i class="@category.Icon text-3xl text-cyberGreen group-hover:text-[#00D4AA] transition-all"></i>
                                }
                            }
                            else
                            {
                                <i class="fa-solid fa-layer-group text-3xl text-cyberGreen"></i>
                            }
                        </div>

                        <span
                            class="text-sm font-medium text-gray-700 dark:text-gray-300 group-hover:text-black dark:group-hover:text-white transition-colors">
                @category.Name
            </span>
                    </div>
                }
            }
        </div>
        <h2 class="text-3xl font-bold mt-16 mb-8 dark:text-white  text-center">Premium elanlar</h2>
        <div id="premium-ads-container"
             class="w-full max-w-[1445px] mx-auto px-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 mb-10 sm:mb-20">
            @foreach (var vacancy in Model.PremiumVacancies)
            {
                <div class="w-full premium-card-border card-base group hover:-translate-y-1 transition-all dark:bg-black">
                    <div
                        class="card-inner dark:bg-black transition-colors border border-gray-100 dark:border-gray-800">
                        <div
                            class="premium-badge-gradient absolute sm:top-2 left-3/4 sm:left-1/2 sm:-translate-x-1/2 px-4 sm:px-6 py-1 sm:py-2 rounded-b-2xl sm:rounded-full text-white text-sm font-bold uppercase z-10 shadow-sm">
                            Premium
                        </div>

                        <div class="flex items-start gap-2.5 my-2 sm:mt-12 overflow-hidden">
                            <div class="size-16 sm:size-10 rounded-full sm:rounded-md overflow-hidden shrink-0">
                                <img src="@vacancy.Company.Logo" alt="@vacancy.Company.Name"
                                     class="w-full h-full object-cover"/>
                            </div>
                            <div class="min-w-0">
                                <h3 class="text-md font-bold text-black dark:text-white leading-tight truncate">@vacancy.Name</h3>
                                <div class="mt-4 sm:mt-1 flex items-center justify-between w-full">
                                    <span class="text-md text-gray-400 font-semibold truncate flex items-center mr-16 gap-1">
                                        @vacancy.Company.Name
                                        @if (vacancy.Company.IsVerified)
                                        {
                                            <iconify-icon icon="material-symbols:verified" class="text-[#2D9CDB]"></iconify-icon>
                                        }
                                    </span>

                                        <span class="sm:hidden flex items-center gap-1 text-gray-400 mr-16">
                                            <i class="fa-regular fa-clock text-md"></i> 
                                            @vacancy.CreatedAt.ToString("dd.MM.yyyy")
                                        </span>
                                        <span class="sm:hidden flex items-center gap-1 text-gray-400 mr-16">
                                            <i class="fa-regular fa-eye text-md"></i> 
                                            @vacancy.ViewCount
                                        </span>
                                </div>
                                </div>
                        </div>

                        <div class="mt-auto hidden sm:block">
                            <div class="w-full h-[0.5px] bg-gray-400/20 dark:bg-gray-800/40 mb-2"></div>
                            <div class="flex justify-between items-center text-gray-400 text-sm">
                                <span class="flex items-center gap-1"><i
                                        class="fa-regular fa-clock text-md"></i> @vacancy.CreatedAt.ToString("dd.MM.yyyy")</span>
                                <span class="flex items-center gap-1"><i
                                        class="fa-regular fa-eye text-md"></i> @vacancy.ViewCount</span>
                                <span class="text-[#B7872B] font-bold ">@vacancy.Salary</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        <h2 class="text-3xl font-bold mb-5 sm:mb-9 dark:text-white">Ən son vakansiyalar</h2>
        <div id="latest-jobs-container"
             class="w-full max-w-[1445px] mx-auto px-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-[10px] mb-10">

            @foreach (var vacancy in Model.LatestVacancies)
            {
                <div
                    class="border border-gray-300 sm:border-gray-400  dark:bg-cyberDark sm:dark:border-gray-800 card-base px-4  sm:p-4 transition-all hover:-translate-y-1 shadow-sm rounded-2xl">
                    <div class="flex items-start gap-2.5 my-2 sm:mt-12  overflow-hidden">
                        <div class="size-16 sm:size-10 rounded-full sm:rounded-md overflow-hidden shrink-0">
                            <img src="@vacancy.Company.Logo" alt="@vacancy.Company.Name"
                                 class="w-full h-full object-cover"/>
                        </div>
                        <div class="min-w-0">
                            <h3 class="text-[16px] font-bold text-black dark:text-white leading-tight truncate">@vacancy.Name</h3>
                            <div class="mt-4 sm:mt-1 flex items-center justify-between w-full">
                                <span class="text-md text-gray-400 font-semibold truncate flex items-center mr-16 gap-1">
                                    @vacancy.Company.Name
                                    @if (vacancy.Company.IsVerified)
                                    {
                                        <iconify-icon icon="material-symbols:verified" class="text-[#2D9CDB]"></iconify-icon>
                                    }
                                </span>

                                <span class="sm:hidden flex items-center gap-1 text-gray-400 mr-16">
                                    <i class="fa-regular fa-clock text-md"></i> 
                                    @vacancy.CreatedAt.ToString("dd.MM.yyyy")
                                </span>
                                <span class="sm:hidden flex items-center gap-1 text-gray-400 mr-16">
                                    <i class="fa-regular fa-eye text-md"></i> 
                                    @vacancy.ViewCount
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="mt-auto">
                        <div class="w-full h-[0.5px] bg-gray-400/20 dark:bg-gray-800/40 mb-2"></div>
                        <div class="hidden sm:block flex justify-between items-center text-gray-400 text-sm">
                            <span class="flex items-center gap-1"><i
                                    class="fa-regular fa-clock text-md"></i> @vacancy.CreatedAt.ToString("dd.MM.yyyy")</span>
                            <span class="flex items-center gap-1"><i
                                    class="fa-regular fa-eye text-md"></i> @vacancy.ViewCount</span>
                            <span class="text-darkGreen font-bold ">@vacancy.Salary</span>
                        </div>
                    </div>
                </div>
            }
        </div>

        <button
            class="px-24 py-6 bg-darkGreen text-white font-bold rounded-lg mb-10 transition-colors hover:bg-black">
            Daha çox
        </button>


        <div class="w-full max-w-full px-16">
            <h2 class="text-center text-4xl font-bold mb-6 text-black dark:text-white">Bizi seçən
                şirkətlər!</h2>
            <div class="w-full h-0.5 bg-gradient-to-r from-transparent via-lightGreen/60 to-transparent mb-6"></div>
            <div
                class="w-full inline-flex flex-nowrap overflow-hidden [mask-image:_linear-gradient(to_right,transparent_0,_black_128px,_black_calc(100%-128px),transparent_100%)]">
                <ul class="flex items-center justify-center md:justify-start [&_li]:mx-12 [&_img]:max-w-none animate-infinite-scroll">
                    @if (Model.Partners != null)
                    {
                        @foreach (var partner in Model.Partners)
                        {
                            <li>
                                <img src="@partner.Image" class="h-13 w-auto object-contain" alt=""/>
                            </li>
                        }

                        @foreach (var partner in Model.Partners)
                        {
                            <li>
                                <img src="@partner.Image" class="h-13 w-auto object-contain" alt=""/>
                            </li>
                        }
                    }
                </ul>
            </div>
            <div class="w-full h-0.5 bg-gradient-to-r from-transparent via-lightGreen/60 to-transparent my-6"></div>

        </div>

        <div class="w-full flex flex-col items-center pb-24 bg-gray-50 mt-3">
    
            <h2 class="relative z-20 text-4xl font-bold mb-3 text-black dark:text-white">Statistika</h2>            
            <div class="inline-flex bg-white dark:bg-cyberMain p-1 rounded-xl mb-16 border dark:border-gray-800 transition-colors relative z-20">
                <button class="px-10 py-2 bg-lightGreen text-white rounded-lg text-sm font-semibold shadow-sm">
                    İzləyici
                </button>
                <button class="px-10 py-2 text-gray-500 dark:text-gray-400 text-sm font-semibold hover:text-cyberMain dark:hover:text-white transition-all">
                    Vakansiya
                </button>
            </div>

            <div class="relative w-full flex flex-col items-center px-10 py-3 mb-16">
                <img src="~/images/statisticBg.svg" alt=""
                     class="absolute inset-x-0 top-1/2 -translate-y-1/2 w-full h-auto opacity-70 pointer-events-none">

                <div class="flex gap-12 mt-14 relative z-10">
                    <div class="text-center">
                        <p class="text-6xl font-bold dark:text-white mb-8 leading-none">143</p>
                        <p class="text-sm font-semibold uppercase tracking-widest">Günlük</p>
                    </div>

                    <div class="text-center">
                        <p class="text-6xl font-semibold dark:text-white mb-8 leading-none">483</p>
                        <p class="text-sm font-semibold uppercase tracking-widest">Həftəlik</p>
                    </div>

                    <div class="text-center">
                        <p class="text-6xl font-bold dark:text-white mb-8 leading-none">777</p>
                        <p class="text-sm font-semibold uppercase tracking-widest">Aylıq</p>
                    </div>

                    <div class="text-center">
                        <p class="text-6xl font-semibold dark:text-white mb-8 leading-none">434</p>
                        <p class="text-sm font-semibold uppercase tracking-widest">Ümumi</p>
                    </div>
                </div>
            </div>

        </div>
        <section class="w-full flex justify-center px-4 mt-12">
            <div
                class="shadow-lg relative group h-full w-full rounded-2xl overflow-hidden">
                @foreach (var banner in Model.Banners)
                {
                    @if (banner.Location == "large")
                    {
                        <img src="@banner.Image"
                             class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                             alt="">
                        break;
                    }
                    
                }

            </div>
        </section>
        <partial name="../Sections/_Subscribe"/>

    </section>


@section Scripts {
    <script src="~/js/home.js"></script>
}