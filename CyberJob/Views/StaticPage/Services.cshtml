@using CyberJob.DTOs
@using CyberJob.ViewModels
@model ServicesVM
@{
    var monthlyPlans = Model.Plans?.Where(p => p.Type == "monthly").ToList() ?? new List<SubscriptionPlanDto>();
    var yearlyPlans = Model.Plans?.Where(p => p.Type == "yearly").ToList() ?? new List<SubscriptionPlanDto>();
}

@section Styles {
    <style>
        @@keyframes premiumPulse {
            0%, 100% { box-shadow: 0 0 20px rgba(194, 157, 85, 0.3), 0 0 40px rgba(194, 157, 85, 0.1); }
            50% { box-shadow: 0 0 30px rgba(194, 157, 85, 0.5), 0 0 60px rgba(194, 157, 85, 0.2), 0 0 80px rgba(194, 157, 85, 0.1); }
        }
        @@keyframes premiumFloat {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-5px); }
        }
        @@keyframes goldShimmer {
            0% { background-position: -200% center; }
            100% { background-position: 200% center; }
        }
        .premium-card {
            animation: premiumPulse 3s ease-in-out infinite, premiumFloat 4s ease-in-out infinite;
        }
        .premium-badge {
            animation: premiumFloat 3s ease-in-out infinite;
        }
        .premium-card::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: conic-gradient(from 0deg at 50% 50%, transparent 0deg, rgba(194,157,85,0.1) 60deg, transparent 120deg);
            animation: goldShimmer 6s linear infinite;
            pointer-events: none;
        }
    </style>
}

<main class="max-w-[1440px] mx-auto px-6 md:px-10 py-16">

    <div class="text-center mb-16">
        <h1 class="text-[42px] font-bold dark:text-white mb-2">@Localizer["services.title"]</h1>
        <p class="text-gray-400 text-lg">@Localizer["services.subtitle"]</p>

        <div class="mt-14 relative inline-block">
            <div id="saveBadge"
                 class="absolute -top-12 left-1/2 -translate-x-1/2 bg-[#F8E15C] text-cyberMain text-md font-bold px-5 py-2 rounded-md shadow-sm whitespace-nowrap">
                @Localizer["services.save_badge"]
                <div class="absolute -right-10 top-2 rotate-[12deg]">
                    <iconify-icon icon="akar-icons:arrow-back"
                                  class="text-black text-4xl opacity-50 flip-horizontal"></iconify-icon>
                </div>
            </div>
            <div class="flex items-center bg-white dark:bg-zinc-900 p-1.5 rounded-2xl w-[220px] border border-gray-200 dark:border-zinc-800">
                <button id="yearlyBtn"
                        class="toggle-btn flex-1 py-3 text-md font-bold rounded-xl transition-all duration-300"
                        data-period="yearly">@Localizer["services.packages"]</button>
                <button id="monthlyBtn"
                        class="toggle-btn flex-1 py-3 text-md font-bold rounded-xl transition-all duration-300"
                        data-period="monthly">@Localizer["services.monthly"]</button>
            </div>
        </div>
    </div>

    <!-- Monthly Plans -->
    <div id="monthlyPlans" class="max-w-6xl mx-auto w-full grid grid-cols-1 md:grid-cols-3 gap-6 items-start mb-32">
        @{
            int monthlyIndex = 0;
        }
        @foreach (SubscriptionPlanDto subscription in monthlyPlans)
        {
            var isPopular = monthlyIndex == 1;
            monthlyIndex++;
            var discount = subscription.OldPrice > 0 ? (subscription.OldPrice - subscription.NewPrice) / subscription.OldPrice * 100 : 0;
            <div class="@(isPopular ? "relative z-10 md:-translate-y-3" : "relative")">
                @if (isPopular)
                {
                    <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-[#003d33] text-white text-[11px] font-bold px-4 py-1.5 rounded-full flex items-center gap-1.5 shadow-md border border-teal-500/30 whitespace-nowrap z-20">
                        <span class="text-yellow-400 text-xs">★</span> @Localizer["services.popular"]
                    </div>
                }
                <div class="@(isPopular
                    ? "bg-white dark:bg-[#0e1e21] rounded-[32px] p-4 pb-8 shadow-[0_0_50px_rgba(20,184,166,0.28)] dark:shadow-[0_0_50px_rgba(20,184,166,0.45)] border-2 border-teal-500/40 dark:border-teal-500/50 flex flex-col"
                    : "bg-white dark:bg-[#0e1e21] rounded-[32px] p-4 pb-8 shadow-[0_0_40px_rgba(20,184,166,0.15)] dark:shadow-[0_0_40px_rgba(20,184,166,0.25)] border border-[#e5ecee] dark:border-[#173035] flex flex-col")">

                    <!-- Inner Card Wrapper -->
                    <div class="bg-white dark:bg-[#0e1e21] rounded-[28px] p-5 shadow-[0_15px_30px_rgba(0,0,0,0.08)] dark:shadow-[0_15px_30px_rgba(0,0,0,0.3)] border border-[#f0f4f5] dark:border-[#1c373d] flex flex-col mb-8">

                        <!-- Header Section -->
                        <div class="@(isPopular
                            ? "bg-gradient-to-b from-[#004d40] to-[#003d33] dark:from-[#003d33] dark:to-[#002d26] rounded-[24px] p-5 pt-6 text-center mb-5"
                            : "bg-[#eff1f3] dark:bg-[#173035] rounded-[24px] p-5 pt-6 text-center mb-5")">
                            <div class="flex justify-between items-center mb-4">
                                <span class="bg-white dark:bg-black text-black dark:text-white px-4 py-1 rounded-full text-xs font-bold shadow-sm">@subscription.Name</span>
                                <span class="bg-[#00e676] text-black text-[11px] font-bold px-3 py-1 rounded-full tracking-wide">@Localizer["services.first_month"]</span>
                            </div>
                            @if (subscription.HasActiveDiscount)
                            {
                                <div class="text-xs font-semibold line-through mb-1 @(isPopular ? "text-teal-200/40 dark:text-teal-300/20" : "text-[#88989c] dark:text-[#6a8085]")">@subscription.OldPrice AZN/ay</div>
                                <div class="flex items-center justify-center gap-2">
                                    <span class="text-4xl font-bold @(isPopular ? "text-white" : "text-slate-950 dark:text-white") tracking-tight">@subscription.NewPrice AZN/ay</span>
                                    <span class="bg-[#ffd600] text-black text-[11px] font-bold px-1.5 py-0.5 rounded shadow-sm">-@((int)discount)%</span>
                                </div>
                            }
                            else
                            {
                                <div class="flex items-center justify-center gap-2 mt-2">
                                    <span class="text-4xl font-bold @(isPopular ? "text-white" : "text-slate-950 dark:text-white") tracking-tight">@subscription.OldPrice AZN/ay</span>
                                </div>
                            }
                        </div>

                        <!-- CTA Button -->
                        <a href="@(await SettingHelper.GetSocialUrl("whatsapp_number"))?text=@Uri.EscapeDataString($"Salam, {subscription.Name} paketini əldə etmək istəyirəm.")" target="_blank" rel="noopener noreferrer" class="block">
                            <div class="w-full @(isPopular ? "bg-[#00897b] hover:bg-[#00796b] shadow-[0_4px_12px_rgba(0,137,123,0.2)]" : "bg-black hover:bg-gray-900 dark:bg-black dark:hover:bg-gray-900") text-white font-bold py-4 px-6 rounded-full transition-all text-sm text-center shadow-sm cursor-pointer">
                                @Localizer["services.get"]
                            </div>
                        </a>
                    </div>

                    <!-- Features -->
                    <ul class="space-y-4 text-[15px] font-semibold px-4">
                        @{
                            int featureIdx = 0;
                        }
                        @foreach (var feature in subscription.Options)
                        {
                            var isFirst = featureIdx == 0;
                            featureIdx++;
                            <li class="flex items-center gap-3.5 @(isFirst ? "text-slate-950 dark:text-slate-100" : "text-[#8c9ba5] dark:text-[#5c6f7a]")">
                                <span class="flex-shrink-0 w-[22px] h-[22px] bg-[#00897b] rounded-full flex items-center justify-center text-white">
                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="4.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"></path></svg>
                                </span>
                                @feature.Name
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }
    </div>

    <!-- Yearly Plans -->
    <div id="yearlyPlans" class="max-w-6xl mx-auto w-full grid grid-cols-1 md:grid-cols-3 gap-6 items-start mb-32 hidden">
        @{
            int yearlyIndex = 0;
        }
        @foreach (SubscriptionPlanDto subscription in yearlyPlans)
        {
            var isPopular = yearlyIndex == 1;
            yearlyIndex++;
            var discount = subscription.OldPrice > 0 ? (subscription.OldPrice - subscription.NewPrice) / subscription.OldPrice * 100 : 0;
            <div class="@(isPopular ? "relative z-10 md:-translate-y-3" : "relative")">
                @if (isPopular)
                {
                    <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-[#003d33] text-white text-[11px] font-bold px-4 py-1.5 rounded-full flex items-center gap-1.5 shadow-md border border-teal-500/30 whitespace-nowrap z-20">
                        <span class="text-yellow-400 text-xs">★</span> @Localizer["services.popular"]
                    </div>
                }
                <div class="@(isPopular
                    ? "bg-white dark:bg-[#0e1e21] rounded-[32px] p-4 pb-8 shadow-[0_0_50px_rgba(20,184,166,0.28)] dark:shadow-[0_0_50px_rgba(20,184,166,0.45)] border-2 border-teal-500/40 dark:border-teal-500/50 flex flex-col"
                    : "bg-white dark:bg-[#0e1e21] rounded-[32px] p-4 pb-8 shadow-[0_0_40px_rgba(20,184,166,0.15)] dark:shadow-[0_0_40px_rgba(20,184,166,0.25)] border border-[#e5ecee] dark:border-[#173035] flex flex-col")">

                    <!-- Inner Card Wrapper -->
                    <div class="bg-white dark:bg-[#0e1e21] rounded-[28px] p-5 shadow-[0_15px_30px_rgba(0,0,0,0.08)] dark:shadow-[0_15px_30px_rgba(0,0,0,0.3)] border border-[#f0f4f5] dark:border-[#1c373d] flex flex-col mb-8">

                        <!-- Header Section -->
                        <div class="@(isPopular
                            ? "bg-gradient-to-b from-[#004d40] to-[#003d33] dark:from-[#003d33] dark:to-[#002d26] rounded-[24px] p-5 pt-6 text-center mb-5"
                            : "bg-[#eff1f3] dark:bg-[#173035] rounded-[24px] p-5 pt-6 text-center mb-5")">
                            <div class="flex justify-between items-center mb-4">
                                <span class="bg-white dark:bg-black text-black dark:text-white px-4 py-1 rounded-full text-xs font-bold shadow-sm">@subscription.Name</span>
                                <span class="bg-[#00e676] text-black text-[11px] font-bold px-3 py-1 rounded-full tracking-wide">@Localizer["services.first_year"]</span>
                            </div>
                            @if (subscription.HasActiveDiscount)
                            {
                                <div class="text-xs font-semibold line-through mb-1 @(isPopular ? "text-teal-200/40 dark:text-teal-300/20" : "text-[#88989c] dark:text-[#6a8085]")">@subscription.OldPrice AZN/il</div>
                                <div class="flex items-center justify-center gap-2">
                                    <span class="text-4xl font-bold @(isPopular ? "text-white" : "text-slate-950 dark:text-white") tracking-tight">@subscription.NewPrice AZN/il</span>
                                    <span class="bg-[#ffd600] text-black text-[11px] font-bold px-1.5 py-0.5 rounded shadow-sm">-@((int)discount)%</span>
                                </div>
                            }
                            else
                            {
                                <div class="flex items-center justify-center gap-2 mt-2">
                                    <span class="text-4xl font-bold @(isPopular ? "text-white" : "text-slate-950 dark:text-white") tracking-tight">@subscription.OldPrice AZN/il</span>
                                </div>
                            }
                        </div>

                        <!-- CTA Button -->
                        <a href="@(await SettingHelper.GetSocialUrl("whatsapp_number"))?text=@Uri.EscapeDataString($"Salam, {subscription.Name} paketini əldə etmək istəyirəm.")" target="_blank" rel="noopener noreferrer" class="block">
                            <div class="w-full @(isPopular ? "bg-[#00897b] hover:bg-[#00796b] shadow-[0_4px_12px_rgba(0,137,123,0.2)]" : "bg-black hover:bg-gray-900 dark:bg-black dark:hover:bg-gray-900") text-white font-bold py-4 px-6 rounded-full transition-all text-sm text-center shadow-sm cursor-pointer">
                                @Localizer["services.get"]
                            </div>
                        </a>
                    </div>

                    <!-- Features -->
                    <ul class="space-y-4 text-[15px] font-semibold px-4">
                        @{
                            int featureIdx = 0;
                        }
                        @foreach (var feature in subscription.Options)
                        {
                            var isFirst = featureIdx == 0;
                            featureIdx++;
                            <li class="flex items-center gap-3.5 @(isFirst ? "text-slate-950 dark:text-slate-100" : "text-[#8c9ba5] dark:text-[#5c6f7a]")">
                                <span class="flex-shrink-0 w-[22px] h-[22px] bg-[#00897b] rounded-full flex items-center justify-center text-white">
                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="4.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"></path></svg>
                                </span>
                                @feature.Name
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }
    </div>

    <section class="mb-40">
        <h2 class="text-center text-[36px] font-bold mb-20 dark:text-white">@Localizer["services.benefits_title"]</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
            <div class="flex flex-col items-center text-center">
                <div class="h-[280px] flex items-end mb-8"><img src="~/images/robot2.png" alt="Blue Tick" class="max-h-full"></div>
                <h3 class="text-xl font-bold max-w-[240px]">@Localizer["services.benefit1"]</h3>
            </div>
            <div class="flex flex-col items-center text-center">
                <div class="h-[280px] flex items-end mb-8"><img src="~/images/robot1.png" alt="Sürətli Nəticə" class="max-h-full"></div>
                <h3 class="text-xl font-bold max-w-[260px]">@Localizer["services.benefit2"]</h3>
            </div>
            <div class="flex flex-col items-center text-center">
                <div class="h-[280px] flex items-end mb-8"><img src="~/images/robot3.png" alt="Maksimum Görünmə" class="max-h-full"></div>
                <h3 class="text-xl font-bold max-w-[260px]">@Localizer["services.benefit3"]</h3>
            </div>
        </div>
    </section>

    <section class="mb-32 max-w-[960px] mx-auto">
        <div class="text-center mb-14">
            <h2 class="text-[32px] font-bold dark:text-white mb-2">@Localizer["services.faq_title"]</h2>
            <p class="text-gray-400">@Localizer["services.faq_subtitle"]</p>
        </div>
        <div id="faq-container" class="space-y-4">
            @if (Model.Faqs is not null)
            {
                foreach (FaqDto faq in Model.Faqs)
                {
                    <div class="faq-item bg-white dark:bg-zinc-900 border border-gray-200 dark:border-zinc-800 rounded-2xl overflow-hidden cursor-pointer px-8 transition-all duration-300 mb-4">
                        <div class="faq-header flex justify-between items-center py-6">
                            <span class="font-bold text-[17px] dark:text-gray-200">@faq?.Question</span>
                            <iconify-icon icon="ph:caret-down-bold" class="faq-icon text-[#009689] text-xl transition-transform duration-300"></iconify-icon>
                        </div>
                        <div class="faq-answer-container transition-all duration-300 ease-in-out" style="max-height: 0; opacity: 0; overflow: hidden;">
                            <div class="faq-answer text-gray-500 text-[15px] leading-relaxed pb-6">@faq?.Answer</div>
                        </div>
                    </div>
                }
            }
        </div>
    </section>

    <section class="bg-white dark:bg-zinc-900 border border-gray-100 dark:border-zinc-800 rounded-[40px] p-12 text-center shadow-xl mb-20">
        <h3 class="text-[26px] font-bold dark:text-white mb-3">@Localizer["services.help_title"]</h3>
        <p class="text-gray-400 text-lg mb-10">@Localizer["services.help_subtitle"]</p>
        <button class="bg-cyberGreen hover:bg-darkGreen text-white font-bold py-5 px-16 rounded-3xl text-lg transition-all shadow-lg shadow-emerald-900/20">
            @Localizer["services.help_button"]
        </button>
    </section>

</main>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // --- Plan Toggle ---
            const monthlyBtn = document.getElementById('monthlyBtn');
            const yearlyBtn = document.getElementById('yearlyBtn');
            const monthlyPlans = document.getElementById('monthlyPlans');
            const yearlyPlans = document.getElementById('yearlyPlans');

            function activatePeriod(period) {
                if (period === 'monthly') {
                    monthlyBtn.className = 'toggle-btn flex-1 py-3 text-md font-bold rounded-xl transition-all duration-300 bg-cyberGreen text-white';
                    yearlyBtn.className = 'toggle-btn flex-1 py-3 text-md font-bold rounded-xl transition-all duration-300 text-gray-400';
                    monthlyPlans.classList.remove('hidden');
                    yearlyPlans.classList.add('hidden');
                } else {
                    yearlyBtn.className = 'toggle-btn flex-1 py-3 text-md font-bold rounded-xl transition-all duration-300 bg-cyberGreen text-white';
                    monthlyBtn.className = 'toggle-btn flex-1 py-3 text-md font-bold rounded-xl transition-all duration-300 text-gray-400';
                    yearlyPlans.classList.remove('hidden');
                    monthlyPlans.classList.add('hidden');
                }
            }

            monthlyBtn.addEventListener('click', () => activatePeriod('monthly'));
            yearlyBtn.addEventListener('click', () => activatePeriod('yearly'));

            // Start with monthly active
            activatePeriod('monthly');

            // --- FAQ Toggle ---
            const faqItems = document.querySelectorAll('.faq-item');
            faqItems.forEach(item => {
                const header = item.querySelector('.faq-header');
                const container = item.querySelector('.faq-answer-container');
                const icon = item.querySelector('.faq-icon');

                header.addEventListener('click', () => {
                    const isOpen = container.style.maxHeight !== "0px";

                    document.querySelectorAll('.faq-answer-container').forEach(el => {
                        el.style.maxHeight = "0px";
                        el.style.opacity = "0";
                        el.closest('.faq-item').classList.remove('border-[#009689]', 'ring-1', 'ring-[#009689]');
                        el.closest('.faq-item').querySelector('.faq-icon').style.transform = "rotate(0deg)";
                    });

                    if (!isOpen) {
                        container.style.maxHeight = container.scrollHeight + "px";
                        container.style.opacity = "1";
                        icon.style.transform = "rotate(180deg)";
                        item.classList.add('border-[#009689]', 'ring-1', 'ring-[#009689]');
                    }
                });
            });
        });
    </script>
}
