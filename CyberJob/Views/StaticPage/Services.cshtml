                    }
                    <div class="rounded-t-xl rounded-b-3xl shadow-2xl @(subscription.IsPremium ? "shadow-amber-500/20" : "shadow-green-500/200") px-2">
                        <div class="@(subscription.IsPremium ? "bg-amber-50 dark:bg-zinc-800" : "bg-gray-100 dark:bg-zinc-800") price-box text-center relative mb-10 rounded-3xl @(subscription.IsPremium ? "pt-8" : "")">
