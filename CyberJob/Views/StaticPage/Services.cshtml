                    ? "bg-white dark:bg-zinc-900 rounded-3xl flex flex-col px-2 transition-transform hover:scale-[1.02] relative overflow-hidden shadow-xl shadow-yellow-500/20 ring-2 ring-[#C29D55] premium-card"
                    : "bg-white dark:bg-zinc-900 rounded-3xl shadow-md shadow-cyberGreen flex flex-col px-2 transition-transform hover:scale-[1.02]")">
