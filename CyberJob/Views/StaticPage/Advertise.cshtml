<div class="max-w-5xl mx-auto my-14">
        <h1 class="text-3xl font-bold text-gray-800 dark:text-white text-center mb-2">@Localizer["advertise.title"]</h1>
        <p class="text-center text-gray-600 dark:text-gray-300 mb-8">@Localizer["advertise.subtitle"]</p>

        <div class="mb-10">
            <h2 class="text-xl font-semibold text-teal-700 dark:text-teal-400 mb-4 flex items-center">
                <iconify-icon icon="fa6-solid:desktop" class="text-cyberGreen mr-2"></iconify-icon> @Localizer["advertise.desktop_banners"]
            </h2>
            <div class="overflow-x-auto shadow-md rounded-lg">
                <table class="w-full text-left border-collapse bg-white dark:bg-gray-800">
                    <thead class="bg-teal-700 text-white">
                        <tr>
                            <th class="p-4">@Localizer["advertise.table.location"]</th>
                            <th class="p-4">@Localizer["advertise.table.size"]</th>
                            <th class="p-4">@Localizer["advertise.table.max_size"]</th>
                            <th class="p-4">@Localizer["advertise.table.formats"]</th>
                        </tr>
                    </thead>
                    <tbody class="text-gray-700 dark:text-gray-200">
                        <tr class="border-b">
                            <td class="p-4">@Localizer["advertise.table.home_top"]</td>
                            <td class="p-4"><span class="bg-teal-100 dark:bg-teal-900 text-teal-800 dark:text-teal-200 px-2 py-1 rounded font-mono">680 × 335</span></td>
                            <td class="p-4">500 KB</td>
                            <td class="p-4">JPG, PNG, WebP, GIF</td>
                        </tr>
                        <tr class="border-b">
                            <td class="p-4">@Localizer["advertise.table.home_bottom"]</td>
                            <td class="p-4"><span class="bg-teal-100 dark:bg-teal-900 text-teal-800 dark:text-teal-200 px-2 py-1 rounded font-mono">1427 × 280</span></td>
                            <td class="p-4">500 KB</td>
                            <td class="p-4">JPG, PNG, WebP, GIF</td>
                        </tr>
                        <tr class="border-b">
                            <td class="p-4">@Localizer["advertise.table.job_details"]</td>
                            <td class="p-4"><span class="bg-teal-100 dark:bg-teal-900 text-teal-800 dark:text-teal-200 px-2 py-1 rounded font-mono">730 × 170</span></td>
                            <td class="p-4">500 KB</td>
                            <td class="p-4">JPG, PNG, WebP, GIF</td>
                        </tr>
                        <tr class="border-b">
                            <td class="p-4">@Localizer["advertise.table.vacancy_list_left"]</td>
                            <td class="p-4"><span class="bg-teal-100 dark:bg-teal-900 text-teal-800 dark:text-teal-200 px-2 py-1 rounded font-mono">271 × 450</span></td>
                            <td class="p-4">500 KB</td>
                            <td class="p-4">JPG, PNG, WebP, GIF</td>
                        </tr>
                        <tr>
                            <td class="p-4">@Localizer["advertise.table.vacancy_list_between"]</td>
                            <td class="p-4"><span class="bg-teal-100 dark:bg-teal-900 text-teal-800 dark:text-teal-200 px-2 py-1 rounded font-mono">911 × 115</span></td>
                            <td class="p-4">500 KB</td>
                            <td class="p-4">JPG, PNG, WebP, GIF</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="mb-10">
            <h2 class="text-xl font-semibold text-teal-700 dark:text-teal-400 mb-4 flex items-center">
                <iconify-icon icon="fa6-solid:mobile-screen-button" class="text-cyberGreen mr-2"></iconify-icon> @Localizer["advertise.mobile_banners"]
            </h2>
            <div class="overflow-x-auto shadow-md rounded-lg">
                <table class="w-full text-left border-collapse bg-white dark:bg-gray-800">
                    <thead class="bg-teal-700 text-white">
                        <tr>
                            <th class="p-4">@Localizer["advertise.table.location"]</th>
                            <th class="p-4">@Localizer["advertise.table.size"]</th>
                            <th class="p-4">@Localizer["advertise.table.max_size"]</th>
                            <th class="p-4">@Localizer["advertise.table.formats"]</th>
                        </tr>
                    </thead>
                    <tbody class="text-gray-700 dark:text-gray-200">
                        <tr class="border-b">
                            <td class="p-4">@Localizer["advertise.table.home_top"]</td>
                            <td class="p-4"><span class="bg-teal-100 dark:bg-teal-900 text-teal-800 dark:text-teal-200 px-2 py-1 rounded font-mono">195 × 95</span></td>
                            <td class="p-4">500 KB</td>
                            <td class="p-4">JPG, PNG, WebP, GIF</td>
                        </tr>
                        <tr class="border-b">
                            <td class="p-4">@Localizer["advertise.table.home_bottom"]</td>
                            <td class="p-4"><span class="bg-teal-100 dark:bg-teal-900 text-teal-800 dark:text-teal-200 px-2 py-1 rounded font-mono">385 × 111</span></td>
                            <td class="p-4">500 KB</td>
                            <td class="p-4">JPG, PNG, WebP, GIF</td>
                        </tr>
                        <tr>
                            <td class="p-4">@Localizer["advertise.table.vacancy_list_between"]</td>
                            <td class="p-4"><span class="bg-teal-100 dark:bg-teal-900 text-teal-800 dark:text-teal-200 px-2 py-1 rounded font-mono">361 × 81</span></td>
                            <td class="p-4">500 KB</td>
                            <td class="p-4">JPG, PNG, WebP, GIF</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="bg-green-50 dark:bg-green-900/30 border border-green-200 dark:border-green-700 p-6 rounded-lg">
            <h3 class="font-bold text-gray-800 dark:text-white mb-3">@Localizer["advertise.notes_title"]</h3>
            <ul class="list-disc list-inside text-gray-700 dark:text-gray-200 space-y-2">
                <li>@Localizer["advertise.note1"]</li>
                <li>@Localizer["advertise.note2"]</li>
                <li>@Localizer["advertise.note3"]</li>
                <li>@Localizer["advertise.note4"]</li>
                <li>@Localizer["advertise.note5"]</li>
            </ul>
        </div>
    </div>