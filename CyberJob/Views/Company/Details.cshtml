@using CyberJob.DTOs
@using static CyberJob.Helpers.HtmlSanitizerHelper
@section Styles {
    <link rel="stylesheet" href="~/css/companyDetails.css"/>
}

<div class="px-4 sm:px-8 lg:px-28 mx-auto py-6 sm:py-10">

    <section
        class="mb-8 sm:mb-10 p-6 sm:p-8 flex flex-col md:flex-row items-center gap-6 sm:gap-8 rounded-xl border-2 border-[#BDE3F9] dark:border-blue-900/50 bg-gradient-to-r from-white via-[#F0F9FF] to-[#CBE9FB] dark:from-zinc-900 dark:via-zinc-900 dark:to-zinc-800">

        <div class="w-[180px] h-[140px] sm:w-[220px] sm:h-[160px] lg:w-[267px] lg:h-[197px] bg-white rounded-[10px] flex items-center justify-center p-4 sm:p-6 shrink-0 shadow-lg overflow-hidden">
            <img src="@Model.Company.Logo" alt="@Model.Company.Name" class="w-full h-full object-contain">
        </div>

        <div class="flex-1 w-full">
            <div class="flex flex-wrap items-center gap-3 sm:gap-4 mb-4 sm:mb-6">
                <span class="inline-flex items-center gap-2">
                    <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold dark:text-white">@Model.Company.Name</h1>
                    @if (Model.Company.IsVerified)
                    {
                        <iconify-icon icon="material-symbols:verified" class="text-lightBlue text-xl sm:text-2xl shrink-0"></iconify-icon>
                    }
                </span>
                <div class="bg-white dark:bg-zinc-800 border border-lightBlue dark:border-blue-800 text-lightBlue dark:text-blue-400 px-3 sm:px-4 py-1 text-[11px] sm:text-sm font-medium rounded-md whitespace-nowrap">
                    @Localizer.Get("company.vacancy_count", Model.Company.VacancyCount)
                </div>
            </div>

            <div class="flex flex-wrap gap-3 sm:gap-4">
                <div
                    class="flex items-center gap-2 sm:gap-3 bg-white dark:bg-[#0a0a0a] border border-gray-200 dark:border-gray-700 rounded-2xl px-4 sm:px-6 py-[18px] sm:py-4 flex-1 min-w-[140px] sm:min-w-[220px]">
                    <iconify-icon icon="fluent:checkbox-person-24-regular"
                                  class="text-[#007CC2] text-2xl sm:text-3xl shrink-0"></iconify-icon>
                    <div class="min-w-0">
                        <p class="text-[#007CC2] dark:text-blue-400 text-[11px] sm:text-[13px] font-medium leading-tight">@Localizer["company.category"]</p>
                        <p class="text-[#007CC2] dark:text-blue-400 text-[12px] sm:text-[14px] font-semibold truncate">@Model.Company.CategoryName</p>
                    </div>
                </div>

                <div
                    class="flex items-center gap-2 sm:gap-3 bg-white dark:bg-zinc-900 border-2 border-extraLightBlue dark:border-blue-900/50 rounded-[15px] px-4 sm:px-6 py-3 sm:py-4 flex-1 min-w-[130px] sm:min-w-[160px]">
                    <iconify-icon icon="fluent:clock-24-regular" class="text-[#007CC2] text-2xl sm:text-3xl shrink-0"></iconify-icon>
                    <div class="min-w-0">
                        <p class="text-[#007CC2] dark:text-blue-400 text-[11px] sm:text-[13px] font-medium leading-tight">@Localizer["company.founded"]</p>
                        <p class="text-[#007CC2] dark:text-blue-400 text-[12px] sm:text-[14px] font-semibold">@Model.Company.FoundedYear</p>
                    </div>
                </div>

                <div
                    class="flex items-center gap-2 sm:gap-3 bg-white dark:bg-zinc-900 border-2 border-extraLightBlue dark:border-blue-900/50 rounded-[15px] px-4 sm:px-6 py-3 sm:py-4 flex-1 min-w-[130px] sm:min-w-[160px]">
                    <iconify-icon icon="fluent:location-24-regular" class="text-[#007CC2] text-2xl sm:text-3xl shrink-0"></iconify-icon>
                    <div class="min-w-0">
                        <p class="text-[#007CC2] dark:text-blue-400 text-[11px] sm:text-[13px] font-medium leading-tight">@Localizer["company.address"]</p>
                        <p class="text-[#007CC2] dark:text-blue-400 text-[12px] sm:text-[14px] font-semibold truncate">@Model.Company.ShortAddress</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <nav class="nav-tabs font-semibold mx-0 sm:mx-12 overflow-x-auto">
        <div class="nav-tab active whitespace-nowrap" onclick="openTab(event, 'vacancies')">@Localizer["company.tab.vacancies"]</div>
        <div class="nav-tab whitespace-nowrap" onclick="openTab(event, 'about')">@Localizer["company.tab.about"]</div>
    </nav>

    <div id="about" class="tab-content">
        <section class="p-6 sm:p-10">
            <h2 class="text-2xl sm:text-3xl text-black dark:text-white font-semibold mb-6 sm:mb-8">@Localizer.Get("company.profile_title", Model.Company.Name)</h2>
            <div class="text-gray-600 dark:text-gray-300 text-base sm:text-lg leading-[1.8] space-y-6">

                @Html.Raw(SanitizeWithLineBreaks(Model.Company.About))

            </div>
            <div class="mt-8 sm:mt-12 space-y-4 border-t dark:border-gray-700 pt-8">
                <p class="font-bold dark:text-white">@Localizer["company.address_label"]: <span
                        class="font-normal text-gray-600 dark:text-gray-400">@Model.Company.Address</span></p>
                <p class="font-bold dark:text-white">@Localizer["company.email"]: <a href="mailto:@Model.Company.Email"
                                                               class="text-lightGreen font-bold">@Model.Company.Email</a>
                </p>
            </div>
        </section>
    </div>

    <div id="vacancies" class="tab-content active">
        <div class="flex flex-col lg:flex-row gap-6 sm:gap-8 items-start">
            <aside class="w-full lg:w-[320px] bg-white dark:bg-[#0a0a0a] rounded-[20px] p-6 border border-gray-100 dark:border-gray-800 shrink-0 sticky top-20">
                <form class="space-y-4"
                      hx-get="/companies/@Model.Company.Id/vacancies"
                      hx-target="#vacancy-list"
                      hx-trigger="load change, keyup delay:500ms from:.filter-input, submit">

                    <input type="text" name="Search" placeholder="@Localizer["company.search_placeholder"]" class="w-full px-4 py-3.5 bg-gray-50 dark:bg-[#1a1a1a] border border-gray-100 dark:border-gray-700 rounded-xl text-sm outline-none transition-colors focus:border-[#009689] dark:text-gray-200 dark:placeholder-gray-500">

                    <select name="CityId" class="w-full px-4 py-3.5 bg-gray-50 dark:bg-[#1a1a1a] border border-gray-100 dark:border-gray-700 rounded-xl text-sm outline-none transition-colors focus:border-[#009689] dark:text-gray-300 dark:placeholder-gray-500 appearance-none">
                        <option value="">@Localizer["company.city_select"]</option>
                        @foreach (var city in Model.Cities)
                        {
                            <option value="@city.Id">@city.Name</option>
                        }
                    </select>
                    @foreach (FilterGroupDto filter in Model.Filters)
                    {
                        <select name="Filters[@filter.Key]" class="filter-input w-full px-4 py-3.5 bg-gray-50 dark:bg-[#1a1a1a] border border-gray-100 dark:border-gray-700 rounded-xl text-sm outline-none transition-colors focus:border-[#009689] dark:text-gray-300 dark:placeholder-gray-500 appearance-none">
                            <option value="">@filter.Name</option>
                            @foreach (var option in filter.Options)
                            {
                                <option value="@option.Key">@option.Name</option>
                            }
                        </select>
                    }

                    <button type="submit"
                            class="w-full py-4 bg-lightGreen text-white font-bold rounded-xl shadow-lg hover:bg-darkGreen transition-all">
                        @Localizer["company.search_button"]
                    </button>
                </form>
            </aside>

            <div id="vacancy-list" class="flex-1 w-full space-y-4">
                <div class="flex justify-center p-10 htmx-indicator">
                    <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-lightGreen"></div>
                </div>
            </div>
        </div>
    </div>

</div>

<script>
    function openTab(evt, tabName) {
        var i, tabcontent, tablinks;
        tabcontent = document.getElementsByClassName("tab-content");
        for (i = 0; i < tabcontent.length; i++) {
            tabcontent[i].classList.remove("active");
        }
        tablinks = document.getElementsByClassName("nav-tab");
        for (i = 0; i < tablinks.length; i++) {
            tablinks[i].classList.remove("active");
        }
        document.getElementById(tabName).classList.add("active");
        evt.currentTarget.classList.add("active");
    }
</script>

