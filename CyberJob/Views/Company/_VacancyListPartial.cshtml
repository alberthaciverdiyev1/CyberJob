@model IEnumerable<CyberJob.DTOs.VacancyListDto>

@if (!Model.Any())
{
    <div class="p-8 sm:p-10 text-center bg-gray-50 dark:bg-zinc-900 rounded-2xl border-2 border-dashed border-gray-200 dark:border-gray-700">
        <p class="text-gray-500 dark:text-gray-400 font-medium">@Localizer["company.no_vacancies"]</p>
    </div>
}
else
{
    @foreach (var vacancy in Model)
    {
        <div class="bg-white dark:bg-[#0a0a0a] rounded-3xl border border-gray-100 dark:border-gray-800 p-4 sm:p-6 flex flex-col sm:flex-row items-start sm:items-center justify-between transition-all hover:border-[#009689] hover:shadow-[0_10px_30px_rgba(0,0,0,0.04)] mb-4 gap-4 sm:gap-0">
            <div class="flex items-center gap-4 sm:gap-7 w-full sm:w-auto">
                <div
                    class="w-16 h-16 sm:w-24 sm:h-24 bg-white dark:bg-zinc-800 rounded-full flex items-center justify-center shrink-0 border border-gray-100 dark:border-gray-700 shadow-sm overflow-hidden">
                    <img src="@vacancy.Company?.Logo" alt="logo" class="w-full h-full object-cover">
                </div>

                <div class="min-w-0 flex-1">
                    <h3 class="text-base sm:text-lg font-semibold text-black dark:text-white mb-1 truncate">@vacancy?.Name</h3>
                    <p class="text-gray-400 dark:text-gray-500 font-semibold flex items-center gap-2 text-sm sm:text-lg flex-wrap">
                        @vacancy?.Company?.Name
                        @if (vacancy?.Company?.IsVerified == true)
                        {
                            <iconify-icon icon="material-symbols:verified"
                                          class="text-[#2D9CDB] text-sm shrink-0"></iconify-icon>
                        }
                        <span class="text-gray-400 font-semibold">@vacancy?.CityName</span>
                    </p>
                    <div class="flex items-center gap-4 sm:gap-6 text-gray-400 text-xs sm:text-sm mt-2 sm:mt-3 font-medium">
                        <span class="flex items-center gap-1 sm:gap-2">
                            <iconify-icon icon="ph:clock-light" class="text-base sm:text-xl"></iconify-icon>
                            @vacancy.CreatedAt?.ToString("dd.MM.yyyy")
                            </span>
                        <span class="flex items-center gap-1 sm:gap-2">
                            <iconify-icon icon="ph:eye-light" class="text-base sm:text-xl"></iconify-icon>
                            @vacancy?.ViewCount @Localizer["company.view_count"]</span>
                    </div>
                </div>
            </div>
            <a asp-controller="Vacancy"
               asp-action="Details"
               asp-route-id="@vacancy.Id"
               class="rounded-[20px] bg-[#1A998D] hover:bg-[#457d79] px-6 sm:px-10 py-3 sm:py-4 text-center text-sm sm:text-lg text-white font-bold transition-all whitespace-nowrap w-full sm:w-auto mt-3 sm:mt-0">@Localizer["company.apply_button"]</a>
        </div>
    }
}
