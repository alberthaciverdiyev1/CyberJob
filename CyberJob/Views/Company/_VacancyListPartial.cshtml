@model IEnumerable<CyberJob.DTOs.VacancyListDto>

@if (!Model.Any())
{
    <div class="p-10 text-center bg-gray-50 rounded-2xl border-2 border-dashed border-gray-200">
        <p class="text-gray-500 font-medium">Axtarışa uyğun vakansiya tapılmadı.</p>
    </div>
}
else
{
    @foreach (var vacancy in Model)
    {
        <div class="job-row-card">
            <div class="flex items-center gap-7">
                <div class="w-[110px] h-[100px] bg-white rounded-2xl flex items-center justify-center p-2 shrink-0 border border-gray-50">
                    <img src="@vacancy.Company?.Logo" alt="logo" class="w-full h-full object-contain">
                </div>

                <div>
                    <h3 class="text-[20px] font-black text-[#0B2036] mb-1.5">@vacancy?.Name</h3>
                    <p class="text-[#0095F6] font-bold flex items-center gap-2 text-[16px]">
                        @vacancy?.Company?.Name
                        <span class="text-gray-400 font-medium ml-2">@vacancy?.CityName</span>
                    </p>
                    <div class="flex items-center gap-6 text-gray-400 text-sm mt-3 font-medium">
                        <span class="flex items-center gap-2"><iconify-icon icon="ph:clock-light" class="text-xl"></iconify-icon> @vacancy?.CreatedAt</span>
                        <span class="flex items-center gap-2"><iconify-icon icon="ph:eye-light" class="text-xl"></iconify-icon> @vacancy?.ViewCount baxış</span>
                    </div>
                </div>
            </div>
            <a asp-controller="Vacancy"
               asp-action="Details"
               asp-route-id="@vacancy.Id"
               class="btn-apply text-center flex items-center justify-center">Detallı</a>
        </div>
    }
}