@using CyberJob.DTOs
@section Styles {
    <link rel="stylesheet" href="~/css/company.css"/>
}

<main class="mx-auto px-4 sm:px-8 lg:px-36 py-8 sm:py-16">

    <div class="text-center mb-10 sm:mb-16 font-semibold">
        <h1 class="text-3xl sm:text-4xl mb-3
               text-black dark:text-white transition-colors duration-300">
            @Localizer["company.title"]
        </h1>
        <p class="text-base sm:text-lg font-medium
              text-black dark:text-white transition-colors duration-300">
            @Localizer["company.description"]
        </p>
    </div>

    <div class="flex flex-col lg:flex-row gap-8 sm:gap-10">
        <aside class="hidden md:block w-full lg:w-[300px] shrink-0">
            <div class="bg-white dark:bg-zinc-900 rounded-2xl border border-lightGreen p-6 sticky top-28 shadow-sm">
                <form id="filter-form"
                      hx-get="/companies"
                      hx-target="#companies-container"
                      hx-push-url="true"
                      hx-trigger="change">

                    <div class="relative mb-8">
                        <span class="absolute inset-y-0 left-4 flex items-center text-lightGreen">
                            <iconify-icon icon="ph:magnifying-glass-bold" class="text-xl"></iconify-icon>
                        </span>
                        <input type="text"
                               name="search"
                               value="@ViewBag.Search"
                               placeholder="@Localizer["company.search_placeholder"]"
                               class="w-full py-3.5 pl-12 pr-4 bg-gray-50 dark:bg-zinc-800 border border-lightGreen rounded-xl text-sm focus:outline-none focus:border-[#1A998D] transition-all dark:text-white dark:placeholder-gray-400"
                               hx-get="/companies"
                               hx-target="#companies-container"
                               hx-push-url="true"
                               hx-trigger="keyup changed delay:500ms, search"
                               hx-include="#filter-form">
                    </div>

                    <div class="space-y-3">
                        <label class="flex items-center gap-3 px-4 py-3 rounded-xl cursor-pointer transition-all hover:bg-gray-50 dark:hover:bg-zinc-800">
                            <input type="checkbox"
                                   name="isVerified"
                                   value="true"
                                   class="w-5 h-5 rounded border-gray-300 text-[#1A998D] focus:ring-[#1A998D] cursor-pointer"
                                   @(Context.Request.Query["isVerified"] == "true" ? "checked" : "")>
                            <span class="text-sm font-semibold text-gray-700 dark:text-gray-300 flex items-center gap-2">
                                <iconify-icon icon="material-symbols:verified" class="text-[#2D9CDB] text-lg"></iconify-icon>
                                @Localizer["company.filter_verified"]
                            </span>
                        </label>

                        <label class="flex items-center gap-3 px-4 py-3 rounded-xl cursor-pointer transition-all hover:bg-gray-50 dark:hover:bg-zinc-800">
                            <input type="checkbox"
                                   name="isPopular"
                                   value="true"
                                   class="w-5 h-5 rounded border-gray-300 text-[#1A998D] focus:ring-[#1A998D] cursor-pointer"
                                   @(Context.Request.Query["isPopular"] == "true" ? "checked" : "")>
                            <span class="text-sm font-semibold text-gray-700 dark:text-gray-300 flex items-center gap-2">
                                <iconify-icon icon="ph:trend-up" class="text-[#1A998D] text-lg"></iconify-icon>
                                @Localizer["company.filter_popular"]
                            </span>
                        </label>
                    </div>
                </form>
            </div>
        </aside>

        <div class="flex-1 min-w-0" id="main-content-area">

            <div class="flex flex-col gap-1 mb-6">
                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       placeholder="@Localizer["company.search_placeholder"]"
                       class="sm:hidden w-lg py-3.5 pl-12 pr-4 bg-gray-50 dark:bg-zinc-800 border border-lightGreen rounded-xl text-sm focus:outline-none focus:border-[#1A998D] transition-all dark:text-white dark:placeholder-gray-500"
                       hx-get="/companies"
                       hx-trigger="keyup changed delay:500ms, search"
                       hx-target="#companies-container"
                       hx-push-url="true"
                       hx-include="#filter-form">
                <div class="relative w-full sm:w-[200px]">
                    <select class="w-full px-4 py-2.5 bg-white dark:bg-[#0a0a0a] border border-[#1A998D] rounded-[10px] text-sm font-semibold text-[#1A998D] appearance-none outline-none cursor-pointer dark:text-lightGreen"
                            name="sort"
                            hx-get="/companies"
                            hx-target="#companies-container"
                            hx-trigger="change">
                        <option value="newest">@Localizer["company.sort_newest"]</option>
                        <option value="popular">@Localizer["company.sort_popular"]</option>
                    </select>
                    <iconify-icon icon="ph:caret-down-bold" class="absolute right-3 top-1/2 -translate-y-1/2 text-[#1A998D] pointer-events-none"></iconify-icon>
                </div>
            </div>

            <div id="companies-container">
                <div id="companies-grid" class="flex flex-wrap gap-4 sm:gap-5 justify-center sm:justify-start">
                    <partial name="_CompanyCard" model="(dynamic)Model" />
                </div>

                <div class="flex justify-center items-center gap-3 mt-16 sm:mt-24 flex-wrap">

                    @if (ViewBag.CurrentPage > 1)
                    {
                        <button hx-get="/companies?page=@(ViewBag.CurrentPage - 1)&search=@ViewBag.Search"
                                hx-target="#companies-container"
                                hx-push-url="true"
                                class="px-5 sm:px-7 py-3 border border-gray-200 dark:border-gray-700 rounded-xl text-gray-500 dark:text-gray-400 font-bold text-[14px] hover:border-[#1A998D] hover:text-[#1A998D] transition-all">
                            @Localizer["pagination.previous"]
                        </button>
                    }

                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <button hx-get="/companies?page=@i&search=@ViewBag.Search"
                                hx-target="#companies-container"
                                hx-push-url="true"
                                class="w-10 h-10 sm:w-12 sm:h-12 flex items-center justify-center rounded-xl font-bold text-[14px] transition-all
                            @(i == ViewBag.CurrentPage
                               ? "bg-[#1A998D] text-white shadow-lg shadow-emerald-700/20"
                               : "border border-gray-200 dark:border-gray-700 text-gray-500 dark:text-gray-400 hover:border-[#1A998D] hover:text-[#1A998D]")">
                            @i
                        </button>
                    }

                    @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                    {
                        <button hx-get="/companies?page=@(ViewBag.CurrentPage + 1)&search=@ViewBag.Search"
                                hx-target="#companies-container"
                                hx-push-url="true"
                                class="px-5 sm:px-7 py-3 border border-gray-200 dark:border-gray-700 rounded-xl text-gray-500 dark:text-gray-400 font-bold text-[14px] hover:border-[#1A998D] hover:text-[#1A998D] transition-all">
                            @Localizer["pagination.next"]
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>

</main>
