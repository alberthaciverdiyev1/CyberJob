@model dynamic

@foreach (var company in Model)
{
    <div class="company-card">
        <div class="flex items-center gap-3">
            <div class="w-12 h-12 flex items-center justify-center bg-gray-50 rounded-lg p-2 shrink-0 border border-gray-50">
                <img src="@company.Logo" alt="@company.Name" class="max-w-full max-h-full object-contain">
            </div>

            <div class="min-w-0">
                <div class="flex items-center gap-1">
                    <h3 class="font-bold text-md text-[#0B2036] leading-tight truncate">@company.Name</h3>
                    @if (company.IsVerified)
                    {
                        <iconify-icon icon="material-symbols:verified" class="text-[#2D9CDB] text-sm shrink-0"></iconify-icon>
                    }
                </div>
            </div>
        </div>
                <p class="text-sm text-gray-500 font-semibold mt-0.5">
                    @company.VacancyCount <span class="font-medium">vakansiya</span>
                </p>

        <div class="w-full flex items-center gap-2">
            <a asp-controller="Company"
               asp-action="Details"
               asp-route-id="@company.Id"
               class="flex-1 py-2.5 bg-lightGreen text-white rounded-lg font-semibold text-sm hover:bg-darkGreen transition-all text-center shadow-sm">
                Detallar
            </a>

        </div>
    </div>
}