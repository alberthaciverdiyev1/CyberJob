@using CyberJob.DTOs
@using static CyberJob.Helpers.HtmlSanitizerHelper
@model BlogDetailDto

@section Styles {
    <link rel="stylesheet" href="~/css/blog-details.css"/>
}

<main class="bg-white dark:bg-black min-h-screen py-10 sm:py-16 lg:py-[60px_0_100px] transition-all duration-300">
    <div class="max-w-[900px] mx-auto px-5">

        <header class="mb-8">
            <h1 class="text-[clamp(22px,4vw,32px)] font-extrabold text-[#0B2036] dark:text-white mb-2.5 leading-tight">@Model.Title</h1>
            <span class="text-sm text-[#64748B] dark:text-[#64748B] font-medium">@Model.CreatedAt</span>
        </header>

        <img src="@Model.Image" alt="IT Professions" class="w-full h-auto max-h-[462px] rounded-2xl mb-9 block object-cover aspect-video">

        <div class="article-content">

            @Html.Raw(Sanitize(Model.Description))

        </div>

    </div>
</main>

