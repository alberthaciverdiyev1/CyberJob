@section Styles {
    <link rel="stylesheet" href="~/css/blog.css"/>
}

<main class="bg-white dark:bg-black min-h-screen pt-10 pb-24 transition-all duration-300">

    <div class="max-w-[1244px] mx-auto px-5">
        <div class="w-full max-w-[1244px] min-h-[272px] mx-auto mb-16 rounded-[10px] flex flex-col items-center justify-center px-5 py-8 hero-box">
            <h1 class="text-[clamp(28px,5vw,40px)] font-extrabold text-[#0B2036] dark:text-white mb-3 text-center">Texnologiyanın Nəbzini Tutun</h1>
            <p class="text-sm text-[#64748B] dark:text-[#94A3B8] text-center max-w-[800px] mb-6 leading-relaxed">Texnologiya dünyasında öz yerinizi tapmaq, inkişaf etmək və uğur qazanmaq üçün ekspert məsləhətləri və
                faydalı məqalələr.</p>

            <form action="/blogs" method="get" class="w-full max-w-[750px] bg-white dark:bg-[#1A2332] min-h-[52px] rounded-xl flex items-center p-1.5 shadow-[0_4px_20px_rgba(0,0,0,0.04)]">
                <iconify-icon icon="ph:magnifying-glass-bold"
                              class="ml-2.5 text-gray-400 text-xl shrink-0"></iconify-icon>
                <input type="text" name="search" value="@Context.Request.Query["search"]" placeholder="Mövzu və ya açar söz axtar..."
                       class="flex-1 border-none outline-none bg-transparent px-3 text-sm min-w-0 text-cyberDark dark:text-white placeholder-gray-400">
                <button type="submit" class="bg-cyberGreen hover:bg-darkGreen text-white font-bold px-5 rounded-lg whitespace-nowrap h-full transition-colors text-sm py-2.5">Axtar</button>
            </form>
        </div>

        <div class="grid grid-cols-[repeat(auto-fill,minmax(280px,1fr))] gap-6 md:gap-8">
            @foreach (var blog in Model)
            {
                <article class="bg-white dark:bg-[#1A2332] rounded-[20px] overflow-hidden border border-black/10 dark:border-white/5 transition-all duration-300 hover:-translate-y-2 hover:shadow-[0_15px_40px_rgba(0,0,0,0.08)]">
                    <img src="@blog.Image" alt="Blog Image" class="w-full h-48 md:h-56 object-cover">
                    <div class="p-5 md:p-6">
                        <div class="flex gap-4 text-xs text-gray-400 font-semibold mb-4">
                            <span class="flex items-center gap-1"><iconify-icon
                                    icon="ph:calendar-blank-bold"></iconify-icon>@blog.CreatedAt</span>
                            <span class="flex items-center gap-1"><iconify-icon
                                    icon="ph:eye-bold"></iconify-icon> @blog.ReadCount</span>
                        </div>
                        <h3 class="text-[17px] md:text-[19px] font-bold text-[#0B2036] dark:text-white mb-3 leading-snug">@blog.Title</h3>
                        @{
                            var cleanText = System.Text.RegularExpressions.Regex.Replace(blog.Description ?? "", "<.*?>", string.Empty);

                            var summary = cleanText.Length > 75 ? cleanText.Substring(0, 75) + "..." : cleanText;
                        }

                        <p class="text-sm text-[#64748B] dark:text-[#94A3B8] mb-5 leading-relaxed">@summary</p>
                        <a asp-controller="Blog" asp-action="Details" asp-route-id="@blog.Id"
                           class="text-[#0B2036] dark:text-white font-bold flex items-center gap-1.5 text-sm no-underline hover:gap-2 transition-all">
                            Daha ətraflı
                            <iconify-icon icon="ph:arrow-right-bold"></iconify-icon>
                        </a>
                    </div>
                </article>
            }
        </div>

        <button class="block mx-auto mt-16 px-12 py-3 border border-gray-200 dark:border-gray-700 rounded-xl bg-white dark:bg-[#1A2332] text-gray-600 dark:text-white font-bold cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">Daha çox</button>
    </div>
</main>

