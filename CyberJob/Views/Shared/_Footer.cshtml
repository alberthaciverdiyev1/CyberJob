@using CyberJob.DTOs
@using CyberJob.Helpers
@inject CyberJob.Helpers.SettingHelper SettingHelper

<partial name="../Sections/_MobileMenu"/>

<footer class="w-full bg-[#0B2036] dark:bg-black pt-12 sm:pt-20 pb-8 sm:pb-12 px-4 sm:px-6 lg:px-10 text-white border-t border-white/5 transition-all">
    <div class="max-w-[1440px] mx-auto">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-8 sm:gap-12 lg:gap-16 pb-12 sm:pb-20 border-b border-white/10">
            <div class="sm:col-span-2 lg:col-span-5 flex flex-col gap-4 sm:gap-6">
                <img src="~/images/cyberlogo.png" alt="CyberJob Logo" class="w-[160px] sm:w-[183px] h-auto object-contain" />
                <div class="space-y-2">
                    <p class="text-gray-300 text-[14px] sm:text-[16px] leading-relaxed">
                        Cyberjob - karyeranıza yeni addım atmaq üçün doğru ünvandır.
                    </p>
                    <p class="text-gray-300 text-[14px] sm:text-[16px] leading-relaxed">
                        İstənilən sahə, istənilən imkan, bir platformada.
                    </p>
                </div>
            </div>
            <div class="sm:col-span-1 lg:col-span-3">
                <h3 class="font-bold text-[16px] sm:text-[18px] mb-4 sm:mb-8 uppercase tracking-widest">KEÇİDLƏR</h3>
                <nav class="flex flex-col gap-3 sm:gap-5 text-gray-300 text-[14px] sm:text-[16px]">
                    <a asp-controller="Vacancy" asp-action="Index" class="hover:text-cyberGreen transition-colors">Vakansiyalar</a>
                    <a asp-controller="Rank" asp-action="Index" class="hover:text-cyberGreen transition-colors">Reytinq cədvəli</a>
                    <a href="/privacy" class="hover:text-cyberGreen transition-colors">Məxfilik</a>
                    <a asp-controller="Company" asp-action="Index" class="hover:text-cyberGreen transition-colors">Şirkətlər</a>
                    <a asp-controller="Blog" asp-action="Index" class="hover:text-cyberGreen transition-colors">Bloq</a>
                    <a asp-controller="StaticPage" asp-action="Advertise" class="hover:text-cyberGreen transition-colors">Reklam</a>
                </nav>
            </div>
            <div class="sm:col-span-1 lg:col-span-4">
                <h3 class="font-bold text-[16px] sm:text-[18px] mb-4 sm:mb-8 uppercase tracking-widest">MƏLUMAT</h3>
                <nav class="flex flex-col gap-3 sm:gap-5 text-gray-300 text-[14px] sm:text-[16px]">
                    <a  asp-controller="StaticPage" asp-action="UserAgreement"  class="hover:text-cyberGreen transition-colors">İstifadəçi razılaşması</a>
                    <a  asp-controller="StaticPage" asp-action="About" class="hover:text-cyberGreen transition-colors">Haqqımızda</a>
                    <a asp-controller="StaticPage" asp-action="Services" class="hover:text-cyberGreen transition-colors">Xidmətlər</a>
                    <a asp-controller="StaticPage" asp-action="Privacy" class="hover:text-cyberGreen transition-colors">Gizlilik Şərtləri</a>
                    <a asp-controller="StaticPage" asp-action="Contact" class="hover:text-cyberGreen transition-colors">Əlaqə</a>
                </nav>
            </div>
        </div>
        <div class="pt-8 sm:pt-12 flex flex-col md:flex-row justify-between items-center gap-6 sm:gap-8">
            <div class="text-gray-400 text-[13px] sm:text-[15px] font-medium text-center md:text-left">
                &copy; 2025-2026 Cyberjob. B&uuml;t&uuml;n h&uuml;quqlar qorunur. V&Ouml;EN: 6501782182
            </div>
            <div class="flex items-center gap-md sm:gap-[10px] flex-wrap justify-center">
                <a href="@(await SettingHelper.Get("whatsapp_number"))" class="w-[36px] sm:w-[40px] h-[36px] sm:h-[40px] bg-white rounded-md flex items-center justify-center hover:bg-cyberGreen transition-all group overflow-hidden" target="_blank" rel="noopener noreferrer" title="WhatsApp">
                    <img src="~/images/vpicon.png" alt="WhatsApp" class="w-[30px] sm:w-[34px] h-[30px] sm:h-[34px] object-contain transition-transform group-hover:scale-110" />
                </a>
                <a href="@(await SettingHelper.Get("telegram_number"))" class="w-[36px] sm:w-[40px] h-[36px] sm:h-[40px] bg-white rounded-md flex items-center justify-center hover:bg-cyberGreen transition-all group overflow-hidden" target="_blank" rel="noopener noreferrer" title="Telegram">
                    <img src="~/images/tgicon.png" alt="Telegram" class="w-[30px] sm:w-[34px] h-[30px] sm:h-[34px] object-contain transition-transform group-hover:scale-110" />
                </a>
                <a href="@(await SettingHelper.Get("instagram_url"))" class="w-[36px] sm:w-[40px] h-[36px] sm:h-[40px] bg-white rounded-md flex items-center justify-center hover:bg-cyberGreen transition-all group overflow-hidden" target="_blank" rel="noopener noreferrer" title="Instagram">
                    <img src="~/images/instaicon.png" alt="Instagram" class="w-[30px] sm:w-[34px] h-[30px] sm:h-[34px] object-contain transition-transform group-hover:scale-110" />
                </a>
                <a href="@(await SettingHelper.Get("facebook_url"))" class="w-[36px] sm:w-[40px] h-[36px] sm:h-[40px] bg-white rounded-md flex items-center justify-center hover:bg-cyberGreen transition-all group overflow-hidden" target="_blank" rel="noopener noreferrer" title="Facebook">
                    <img src="~/images/fbicon.png" alt="Facebook" class="w-[30px] sm:w-[32px] h-[30px] sm:h-[32px] object-contain transition-transform group-hover:scale-110" />
                </a>
                <a href="@(await SettingHelper.Get("linkedin_url"))" class="w-[36px] sm:w-[40px] h-[36px] sm:h-[40px] bg-white rounded-md flex items-center justify-center hover:bg-cyberGreen transition-all group overflow-hidden" target="_blank" rel="noopener noreferrer" title="LinkedIn">
                    <img src="~/images/lnkicon.png" alt="LinkedIn" class="w-[30px] sm:w-[34px] h-[30px] sm:h-[34px] object-contain transition-transform group-hover:scale-110" />
                </a>
                <a href="@(await SettingHelper.Get("tiktok_url"))" class="w-[36px] sm:w-[40px] h-[36px] sm:h-[40px] bg-white rounded-md flex items-center justify-center hover:bg-cyberGreen transition-all group overflow-hidden" target="_blank" rel="noopener noreferrer" title="TikTok">
                    <iconify-icon icon="ph:tiktok-logo-fill" class="text-black text-lg sm:text-xl transition-transform group-hover:scale-110"></iconify-icon>
                </a>
                <a href="@(await SettingHelper.Get("youtube_url"))" class="w-[36px] sm:w-[40px] h-[36px] sm:h-[40px] bg-white rounded-md flex items-center justify-center hover:bg-cyberGreen transition-all group overflow-hidden" target="_blank" rel="noopener noreferrer" title="YouTube">
                    <iconify-icon icon="ph:youtube-logo-fill" class="text-black text-lg sm:text-xl transition-transform group-hover:scale-110"></iconify-icon>
                </a>
                <a href="@(await SettingHelper.Get("twitter_url"))" class="w-[36px] sm:w-[40px] h-[36px] sm:h-[40px] bg-white rounded-md flex items-center justify-center hover:bg-cyberGreen transition-all group overflow-hidden" target="_blank" rel="noopener noreferrer" title="Twitter / X">
                    <iconify-icon icon="ph:x-logo-fill" class="text-black text-lg sm:text-xl transition-transform group-hover:scale-110"></iconify-icon>
                </a>
            </div>
        </div>
    </div>
</footer>
