<header class="w-full sticky top-0 z-[100] transition-colors duration-300 
               bg-[#0B2036] dark:bg-black border-b border-white/10">
   <div class="max-w-[1440px] mx-auto px-10 h-[96px] flex items-center justify-between">
       
      <div class="flex items-center shrink-0 cursor-pointer" onclick="location.href='/'">
         <img src="~/images/cyberlogo.png"
              alt="CyberJob Logo"
              asp-append-version="true"
              class="w-[183px] h-[34px] object-contain object-left transition-transform hover:scale-105"/>
      </div>

      <nav class="hidden lg:flex items-center justify-center gap-[55px] h-[24px]">
         <a asp-controller="Vacancy" asp-action="Index" class="nav-link text-white text-[15px] font-medium hover:text-[#00D4AA] transition-all">Vakansiyalar</a>
         <a asp-controller="Rank" asp-action="Index" class="nav-link text-white text-[15px] font-medium hover:text-[#00D4AA] transition-all">Reytinq cədvəli</a>
         <a asp-controller="Company" asp-action="Index" class="nav-link text-white text-[15px] font-medium hover:text-[#00D4AA] transition-all">Şirkətlər</a>
         <a asp-controller="StaticPage" asp-action="Services" class="nav-link text-white text-[15px] font-medium hover:text-[#00D4AA] transition-all">Xidmətlər</a>
         <a asp-controller="StaticPage" asp-action="About" class="nav-link text-white text-[15px] font-medium hover:text-[#00D4AA] transition-all">Haqqımızda</a>
         <a asp-controller="Blog" asp-action="Index" class="nav-link text-white text-[15px] font-medium hover:text-[#00D4AA] transition-all">Bloqlar</a>
         <a asp-controller="StaticPage" asp-action="Contact" class="nav-link text-white text-[15px] font-medium hover:text-[#00D4AA] transition-all">Əlaqə</a>
      </nav>

      <div class="flex items-center gap-3 shrink-0">
         <button id="theme-toggle"
                 type="button"
                 class="w-[42px] h-[42px] flex items-center justify-center rounded-lg border border-white/10 text-white hover:bg-white/5 transition-all">
             
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" 
                 class="block dark:hidden">
               <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>

            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" 
                 class="hidden dark:block">
               <circle cx="12" cy="12" r="5"></circle>
               <line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line>
               <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
               <line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line>
               <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </svg>
         </button>

         <div class="flex items-center gap-2 cursor-pointer group px-2 py-2 rounded-lg hover:bg-white/5">
            <span class="text-white font-bold text-[15px] tracking-wide uppercase">AZ</span>
         </div>
      </div>
   </div>
</header>
