@using Microsoft.EntityFrameworkCore.Query
<!DOCTYPE html>
<html lang="az">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
        rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css"
        integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw=="
        crossorigin="anonymous" referrerpolicy="no-referrer"/>
  <script src="https://unpkg.com/htmx.org@1.9.10"></script>

  @await RenderSectionAsync("Styles", required: false)

  <style>
    .htmx-request #companies-grid {
      opacity: 0.5;
      transition: opacity 0.2s ease-in;
    }
  </style>

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          animation: {
            'infinite-scroll': 'infinite-scroll 25s linear infinite',
          },
          keyframes: {
            'infinite-scroll': {
              from: {transform: 'translateX(0)'},
              to: {transform: 'translateX(-50%)'},
            }
          },
          colors: {
            cyberMain: '#0B2036',
            cyberGreen: '#009689',
            promoGreen: '#00FF00',
            darkGreen: '#154E4D',
            lightGreen: "#1A998D",
            darkMode: '#010C0F',
            extraLightGreen: "#00D4AA",
            gold: "#C29D55",
            goldStart:"#F3E2B9",
            goldEnd:"#B08B45",
            tableColor:"#293047"
          }
        }
      }
    }
  </script>

  <style>
    body {
      font-family: 'Inter', sans-serif;
      background-color: #F8FAFB;
      margin: 0;
    }

    .company-card {
      transition: all 0.3s ease;
      border: 1px solid #E5E7EB;
    }

    .company-card:hover {
      transform: translateY(-5px);
      border-color: #009689;
    }
  </style>
  <title>CyberJob</title>
</head>
<body class="bg-gray-50 dark:bg-darkMode text-cyberMain dark:text-white antialiased transition-colors duration-500">
@await Html.PartialAsync("_Header")


<main class="flex-grow dark:bg-darkMode transition-colors duration-500">
  @RenderBody()
</main>

@await Html.PartialAsync("_Footer")
@await RenderSectionAsync("Scripts", false)
<script src="~/js/theme.js"></script>
</body>
</html>