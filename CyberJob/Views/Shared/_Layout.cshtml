@using Microsoft.EntityFrameworkCore.Query
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject CyberJob.Services.LanguageService LangService
@{ var csrfToken = Antiforgery.GetAndStoreTokens(Context).RequestToken; }

<!DOCTYPE html>
<html lang="@LangService.GetCurrentLanguage()">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true">
  
  <script src="https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
        rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
        integrity="sha512-8Yc+2B1pG5s3Ww6JjfD9U3DH4S1l9rSSCvEhZw/WAt1J7T0cscQfMv7IIG2o0Mxw0n8ZWkY9DbDlVwk4P4RDbQ=="
        crossorigin="anonymous" referrerpolicy="no-referrer"/>
  <script src="https://unpkg.com/htmx.org@1.9.10"></script>

  @await RenderSectionAsync("Styles", required: false)

  @Html.Raw(await SettingHelper.GetScript("header"))
  <script>
    (function() {
      var theme = localStorage.getItem('theme');
      if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      }
    })();
  </script>
  <style>
    .htmx-request #companies-grid {
      opacity: 0.5;
      transition: opacity 0.2s ease-in;
    }

    /* Hide scrollbar for category pills & other overflow-x containers */
    .scrollbar-hide {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    .scrollbar-hide::-webkit-scrollbar {
      display: none;
    }

    /* Smooth dark mode transition for background, border, color */
    *, *::before, *::after {
      transition-property: background-color, border-color, color;
      transition-duration: 300ms;
      transition-timing-function: ease;
    }

    .no-theme-transition, .no-theme-transition * {
      transition: none !important;
    }
  </style>

  <title>CyberJob</title>
  <script>window._csrfToken = '@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(csrfToken)';</script>
</head>
<body class="bg-gray-50 dark:bg-darkMode text-cyberMain dark:text-white antialiased">
@Html.Raw(await SettingHelper.GetScript("body"))

@await Html.PartialAsync("_Header")


<main class="flex-grow transition-colors duration-300">
  @RenderBody()
</main>

@await Html.PartialAsync("_Footer")
@await RenderSectionAsync("Scripts", false)

@Html.Raw(await SettingHelper.GetScript("footer"))

<script src="~/js/theme.js"></script>
</body>
</html>
