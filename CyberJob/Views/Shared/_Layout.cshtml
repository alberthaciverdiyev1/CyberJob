@using Microsoft.EntityFrameworkCore.Query
@using CyberJob.Helpers
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject CyberJob.Services.LanguageService LangService
@{
    var csrfToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    var faviconPath = await SettingHelper.Get("favicon");
    var faviconUrl = string.IsNullOrWhiteSpace(faviconPath) ? "/favicon.ico" : faviconPath.ToAdminUrl();
}

<!DOCTYPE html>
<html lang="@LangService.GetCurrentLanguage()">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" href="@faviconUrl">
  <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true">

  <link rel="preconnect" href="https://cdnjs.cloudflare.com">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com">

  <script src="https://code.iconify.design/iconify-icon/2.3.0/iconify-icon.min.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
        rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
        integrity="sha512-8Yc+2B1pG5s3Ww6JjfD9U3DH4S1l9rSSCvEhZw/WAt1J7T0cscQfMv7IIG2o0Mxw0n8ZWkY9DbDlVwk4P4RDbQ=="
        crossorigin="anonymous" referrerpolicy="no-referrer"/>
  <script src="https://unpkg.com/htmx.org@1.9.10"></script>

  @await RenderSectionAsync("Styles", required: false)

  @Html.Raw(await SettingHelper.GetScript("header"))
  <script>
    (function() {
      var theme = localStorage.getItem('theme');
      if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      }
    })();
  </script>
  <style>
    .htmx-request #companies-grid {
      opacity: 0.5;
      transition: opacity 0.2s ease-in;
    }

    /* Hide scrollbar for category pills & other overflow-x containers */
    .scrollbar-hide {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    .scrollbar-hide::-webkit-scrollbar {
      display: none;
    }

    /* Smooth dark mode transition for background, border, color */
    *, *::before, *::after {
      transition-property: background-color, border-color, color;
      transition-duration: 300ms;
      transition-timing-function: ease;
    }

    .no-theme-transition, .no-theme-transition * {
      transition: none !important;
    }
  </style>

  <title>CyberJob</title>
  <script>window._csrfToken = '@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(csrfToken)';</script>
</head>
<body class="bg-gray-50 dark:bg-darkMode text-cyberMain dark:text-white antialiased">
@Html.Raw(await SettingHelper.GetScript("body"))

@await Html.PartialAsync("_Header")


<main class="flex-grow transition-colors duration-300">
  @RenderBody()
</main>

@await Html.PartialAsync("_Footer")
@await RenderSectionAsync("Scripts", false)

@Html.Raw(await SettingHelper.GetScript("footer"))

<script src="~/js/theme.js"></script>

<!-- Scroll to Top Button -->
<button id="scroll-to-top"
        onclick="window.scrollTo({top:0,behavior:'smooth'})"
        aria-label="Scroll to top"
        class="fixed bottom-24 sm:bottom-6 right-6 z-50 w-12 h-12 rounded-full bg-lightGreen text-white shadow-lg flex items-center justify-center transition-all duration-300 hover:bg-extraLightGreen hover:scale-110 active:scale-95 opacity-0 invisible translate-y-4">
    <iconify-icon icon="ph:arrow-up-bold" class="text-xl"></iconify-icon>
</button>

<script>
    (function() {
        const btn = document.getElementById('scroll-to-top');
        if (!btn) return;
        let ticking = false;
        window.addEventListener('scroll', function() {
            if (!ticking) {
                window.requestAnimationFrame(function() {
                    if (window.scrollY > 400) {
                        btn.classList.remove('opacity-0', 'invisible', 'translate-y-4');
                        btn.classList.add('opacity-100', 'visible', 'translate-y-0');
                    } else {
                        btn.classList.remove('opacity-100', 'visible', 'translate-y-0');
                        btn.classList.add('opacity-0', 'invisible', 'translate-y-4');
                    }
                    ticking = false;
                });
                ticking = true;
            }
        }, { passive: true });
    })();
</script>
</body>
</html>
