@{
    ViewData["Title"] = Localizer["error.title"];
}

<div class="min-h-[70vh] flex items-center justify-center px-4 sm:px-8">
    <div class="text-center max-w-2xl mx-auto">
        <!-- 500 Text -->
        <div class="relative mb-10">
            <div class="text-[140px] sm:text-[200px] font-black leading-none tracking-tighter select-none">
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-400 to-red-500">5</span>
                <span class="text-transparent bg-clip-text bg-gradient-to-b from-gray-300 to-gray-500 dark:from-gray-600 dark:to-gray-800">0</span>
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-500 to-red-400">0</span>
            </div>
            <div class="absolute -top-4 -right-4 sm:-top-8 sm:-right-8 text-gray-200 dark:text-gray-800 select-none">
                <iconify-icon icon="ph:warning-circle" class="text-6xl sm:text-8xl opacity-30"></iconify-icon>
            </div>
        </div>

        <!-- Icon -->
        <div class="flex justify-center mb-8">
            <div class="w-28 h-28 sm:w-36 sm:h-36 rounded-full bg-red-50 dark:bg-red-950/30 border-2 border-red-100 dark:border-red-900/50 flex items-center justify-center">
                <iconify-icon icon="ph:wrench" class="text-6xl sm:text-7xl text-red-300 dark:text-red-700"></iconify-icon>
            </div>
        </div>

        <!-- Message -->
        <h1 class="text-3xl sm:text-4xl font-bold dark:text-white mb-4">@Localizer["error.title"]</h1>
        <p class="text-gray-500 dark:text-gray-400 text-base sm:text-lg mb-2">@Localizer["error.subtitle"]</p>
        <p class="text-gray-400 dark:text-gray-500 text-sm sm:text-base mb-10">@Localizer["error.desc"]</p>

        <!-- Home Button -->
        <a href="/"
           class="inline-flex items-center gap-3 bg-gray-800 hover:bg-black dark:bg-gray-200 dark:hover:bg-white text-white dark:text-gray-900 font-bold px-8 py-4 rounded-2xl transition-all shadow-lg group">
            <iconify-icon icon="ph:house-bold" class="text-xl group-hover:-translate-y-0.5 transition-transform"></iconify-icon>
            <span>@Localizer["notfound.home"]</span>
        </a>
    </div>
</div>
